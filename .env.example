# Configuration for the local stack. Every variable is described in docs/configuration.md.
#
# Run scripts/setup/new-env.sh to create .env with generated secrets, or copy this
# file to .env and fill in the empty values. Never commit .env.
# Secrets must be set before the first `docker compose up`, because the database and OpenEMR
# admin passwords are only applied on a fresh volume.

# --- Images ---
# Pinned by digest so a rebuild cannot change them silently. Update deliberately.
MARIADB_IMAGE=mariadb:12.3.3@sha256:805c8e104bd563d5bfa24fadd3f31cd419ea859cb5277f32b5dbf2db714f9ed1
# The restored snapshot was made with this version; changing it needs a new snapshot.
OPENEMR_IMAGE=openemr/openemr:8.0.0.3
PHPMYADMIN_IMAGE=phpmyadmin:5.2.3@sha256:0b38dba8580a95729813799e36623042ac5e23af19d8c50f8003b19f4b980726

# --- Host ports ---
# Published on this address only. 127.0.0.1 keeps the database, phpMyAdmin and the apps off your network;
# set 0.0.0.0 only to expose the stack deliberately (the default credentials are well known).
HOST_BIND_ADDRESS=127.0.0.1
# Scripts, tests and the AuthFacade OAuth redirect URI follow these. Change them here only.
OPENEMR_HTTP_PORT=8300
OPENEMR_HTTPS_PORT=9300
DB_PORT=8320
PHPMYADMIN_PORT=8310
AUTHFACADE_HTTP_PORT=7128

# --- Database ---
DB_NAME=openemr
DB_USER=openemr
# Secrets: generated by new-env.sh.
DB_ROOT_PASSWORD=
DB_PASSWORD=

# --- OpenEMR admin account ---
OPENEMR_ADMIN_USER=admin
# Secret. Leave as `ci-admin-password` when restoring the snapshot: its admin hash matches it.
OPENEMR_ADMIN_PASSWORD=

# --- AuthFacade runtime ---
# Production hides the OpenAPI document and Scalar UI, error details and debug logging. Use Development
# only on your own machine, to browse /scalar/v1.
AUTHFACADE_ENVIRONMENT=Production

# --- AuthFacade OAuth client (registered in OpenEMR by the seed service) ---
AUTHFACADE_CLIENT_ID=authfacade
# Secret: generated by new-env.sh.
AUTHFACADE_CLIENT_SECRET=

# --- Integration tests ---
# Minutes to wait for the stack. Use 2 for a warm stack, 30 for a fresh install.
STACK_READY_TIMEOUT_MINUTES=2
