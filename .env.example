# Copy to .env and fill in. Never commit .env.
# Secrets must be set before the first `docker compose up`, because the
# database and OpenEMR admin password are only applied on a fresh volume.

# --- Images (pinned by digest; update when upgrading) ---
MARIADB_IMAGE=mariadb:12.3.3@sha256:805c8e104bd563d5bfa24fadd3f31cd419ea859cb5277f32b5dbf2db714f9ed1
OPENEMR_IMAGE=openemr/openemr:8.0.0.3
PHPMYADMIN_IMAGE=phpmyadmin:5.2.3@sha256:0b38dba8580a95729813799e36623042ac5e23af19d8c50f8003b19f4b980726

# --- Host ports ---
WT_HTTP_PORT=8300
WT_HTTPS_PORT=9300
WT_MYSQL_PORT=8320
WT_PMA_PORT=8310
FACADE_HTTP_PORT=7128

# --- Database (secrets) ---
DB_ROOT_PASSWORD=
DB_NAME=openemr
DB_USER=openemr
DB_PASSWORD=

# --- OpenEMR admin (secrets) ---
OE_USER=admin
OE_PASS=

# --- OpenEMR OAuth client for AuthFacade ---
AUTHFACADE_CLIENT_ID=
AUTHFACADE_CLIENT_SECRET=

# --- AuthFacade (secret) ---
# At least 32 characters
JWT_KEY=

# --- Integration tests ---
# Minutes to wait for the stack. Use 2 for a warm stack, 30 for a fresh install.
STACK_READY_TIMEOUT_MINUTES=2