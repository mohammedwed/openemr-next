# Copy to .env and fill in, or run scripts/env-management/new-env.sh to generate it.
# Never commit .env. Secrets must be set before the first `docker compose up`,
# because the database and OpenEMR admin password are only applied on a fresh volume.

# --- Images (pinned by digest; update when upgrading) ---
MARIADB_IMAGE=mariadb:12.3.3@sha256:805c8e104bd563d5bfa24fadd3f31cd419ea859cb5277f32b5dbf2db714f9ed1
OPENEMR_IMAGE=openemr/openemr:8.0.0.3
PHPMYADMIN_IMAGE=phpmyadmin:5.2.3@sha256:0b38dba8580a95729813799e36623042ac5e23af19d8c50f8003b19f4b980726

# --- Host ports (scripts, tests, and the AuthFacade OAuth redirect URI follow these) ---
WT_HTTP_PORT=8300
WT_HTTPS_PORT=9300
WT_MYSQL_PORT=8320
WT_PMA_PORT=8310
FACADE_HTTP_PORT=7128

# --- Database ---
DB_NAME=openemr
DB_USER=openemr
# Secrets
DB_ROOT_PASSWORD=
DB_PASSWORD=

# --- OpenEMR admin ---
OE_USER=admin
# Secret. The restored snapshot's admin hash matches `ci-admin-password`.
OE_PASS=

# --- AuthFacade OAuth client ---
AUTHFACADE_CLIENT_ID=authfacade
# Secret
AUTHFACADE_CLIENT_SECRET=

# --- Integration tests ---
# Minutes to wait for the stack. Use 2 for a warm stack, 30 for a fresh install.
STACK_READY_TIMEOUT_MINUTES=2
