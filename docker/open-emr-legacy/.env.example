# Copy to .env and fill in. Never commit .env.

# --- Images (pinned by digest; update when upgrading) ---
MARIADB_IMAGE=mariadb:12.3.3@sha256:805c8e104bd563d5bfa24fadd3f31cd419ea859cb5277f32b5dbf2db714f9ed1
OPENEMR_IMAGE=openemr/openemr:flex@sha256:c9d9b0100f51bdb37dd5abe5e960860f35267595865b5a23f3f8ee1547a743f1
SELENIUM_IMAGE=selenium/standalone-chromium:152.0.7977.82@sha256:08fd293648e126275782c616a61f4ee1d90cf413b1972ebc35dbd054d6789f55
PHPMYADMIN_IMAGE=phpmyadmin:5.2.3@sha256:0b38dba8580a95729813799e36623042ac5e23af19d8c50f8003b19f4b980726
COUCHDB_IMAGE=couchdb:3.5.2@sha256:8cf5f8442585c346d2717ff0ad95605731d2f19f67b8367840baa8d3b24ebc31
LDAP_IMAGE=openemr/dev-ldap:easy@sha256:b1dbb4b1f1074b6a298dabd256b80d766bccbfca99aa89d023cf894d6f4c57aa
MAILPIT_IMAGE=axllent/mailpit:v1.31.3@sha256:ed9b00c609e77e99c79b93f1178255ebc271868920f2c69a8d166bd5634ed10d

# --- Host paths and host user ---
OPENEMR_DIR=../..
HOST_UID=1000
HOST_GID=1000

# --- Host ports ---
WT_HTTP_PORT=8300
WT_HTTPS_PORT=9300
WT_MYSQL_PORT=8320
WT_PMA_PORT=8310
WT_COUCHDB_PORT=5984
WT_COUCHDB_SSL_PORT=6984
WT_SELENIUM_PORT=4444
WT_VNC_PORT=7900
WT_MAILPIT_UI_PORT=8025
WT_MAILPIT_SMTP_PORT=1025

# --- Database (secrets) ---
DB_ROOT_PASSWORD=
DB_USER=openemr
DB_PASSWORD=

# --- OpenEMR admin (secrets) ---
OE_USER=admin
OE_PASS=

# --- CouchDB (secrets) ---
COUCHDB_USER=admin
COUCHDB_PASSWORD=

# --- Selenium VNC (secret) ---
SE_VNC_PASSWORD=

# --- SMTP (Mailpit accepts any credentials, but keep them out of the file) ---
SMTP_USER=openemr
SMTP_PASS=

# --- GitHub composer token (secret) ---
GITHUB_COMPOSER_TOKEN=
GITHUB_COMPOSER_TOKEN_ENCODED=
GITHUB_COMPOSER_TOKEN_ENCODED_ALTERNATE=

# --- Optional developer toggles ---
XDEBUG_ON=1
XDEBUG_PROFILER_ON=1
XDEBUG_CLIENT_HOST=host.docker.internal