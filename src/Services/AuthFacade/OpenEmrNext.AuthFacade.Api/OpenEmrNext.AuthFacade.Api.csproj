<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>0de9cd28-4c88-448f-960c-04926464ca30</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.3" />
    <PackageReference Include="OpenIddict.Client" Version="7.7.2" />
    <PackageReference Include="OpenIddict.Client.AspNetCore" Version="7.7.2" />
    <PackageReference Include="OpenIddict.Client.SystemNetHttp" Version="7.7.2" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.7.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <!--
      OpenIddict.Client.SystemNetHttp transitively pulls in Microsoft.Extensions.Http.Polly, which still
      depends on the legacy Polly v7 package. Its Polly.CircuitBreaker.BrokenCircuitException collides, at
      COMPILE time, with the same type name in Polly.Core v8, which CircuitBreakerPipeline.cs already uses
      directly — so compile assets are excluded to drop it from the compiler's reference set. Runtime assets
      are kept: OpenIddict.Client.SystemNetHttp's own handler configuration actually loads Polly v7 at
      startup (confirmed — excluding "all" instead of "compile" here throws FileNotFoundException for it).
    -->
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.11" ExcludeAssets="compile" />
    <PackageReference Include="Polly" Version="7.2.4" ExcludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenEmrNext.AuthFacade.Application\OpenEmrNext.AuthFacade.Application.csproj" />
    <ProjectReference Include="..\OpenEmrNext.AuthFacade.Composition\OpenEmrNext.AuthFacade.Composition.csproj" />
    <ProjectReference Include="..\OpenEmrNext.AuthFacade.Infrastructure\OpenEmrNext.AuthFacade.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>OpenEmrNext.AuthFacade.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
