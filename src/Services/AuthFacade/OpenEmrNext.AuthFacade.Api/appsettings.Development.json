{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.IdentityModel": "Debug"
    }
  },
  "OpenEmr": {
    "BaseUrl": "https://localhost:9300",
    "Issuer": "https://localhost:9300/oauth2/default",
    "Scope": "openid api:oemr",
    "RedirectUri": "http://localhost:7128/callback",
    "AcceptAnyServerCertificate": true
  },
  "BrowserFlow": {
    "DefaultReturnUrl": "http://localhost:7129/",
    "ReturnUrlAllowedHosts": [ "localhost" ]
  }
}