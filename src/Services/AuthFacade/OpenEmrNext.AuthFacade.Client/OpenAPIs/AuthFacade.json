{
  "openapi": "3.1.1",
  "info": {
    "title": "AuthFacade API",
    "description": "A BFF in front of OpenEMR. Log in through GET /oidc/login, and the session cookie it establishes authorizes the other endpoints.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:63150/"
    }
  ],
  "paths": {
    "/api/v1/me": {
      "get": {
        "tags": [
          "Identity"
        ],
        "summary": "Get the subject and name of the bearer token",
        "operationId": "GetCurrentUser",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            ".AspNetCore.AuthFacadeSession": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "MeResponse": {
        "required": [
          "subject",
          "name"
        ],
        "type": "object",
        "properties": {
          "subject": {
            "type": [
              "null",
              "string"
            ]
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      ".AspNetCore.AuthFacadeSession": {
        "type": "apiKey",
        "description": "The session cookie /callback sets after a successful browser login through /oidc/login (ADR 0026). Only usable by a caller sharing that cookie jar, such as the Login UI.",
        "name": ".AspNetCore.AuthFacadeSession",
        "in": "cookie"
      }
    }
  },
  "tags": [
    {
      "name": "Identity"
    }
  ]
}
