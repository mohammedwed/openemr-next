{
  "openapi": "3.1.1",
  "info": {
    "title": "ClinicalCare API",
    "description": "Clinical encounters (and, later, vitals). Every endpoint requires the shared X-Internal-Gateway-Secret header (ADR 0055, ADR 0064) -- there is no per-user authentication yet, so the acting provider is supplied by the caller.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/encounters": {
      "post": {
        "tags": [
          "Encounters"
        ],
        "summary": "Create an encounter for a registered patient",
        "operationId": "CreateEncounter",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEncounterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EncounterCreatedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalGateway": []
          }
        ]
      },
      "get": {
        "tags": [
          "Encounters"
        ],
        "summary": "List one patient's encounters, newest first, one bounded page at a time",
        "operationId": "ListEncounters",
        "parameters": [
          {
            "name": "patientUuid",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EncounterListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalGateway": []
          }
        ]
      }
    },
