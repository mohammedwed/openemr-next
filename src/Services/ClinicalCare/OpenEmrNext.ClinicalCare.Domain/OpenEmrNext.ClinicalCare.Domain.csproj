<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mutation and reconstitution members that only the persisting adapter or the tests may call are
         internal (DOM-5, DOM-9); these two assemblies are the only ones allowed to see them. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>OpenEmrNext.ClinicalCare.Infrastructure</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>OpenEmrNext.ClinicalCare.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
