@page "/"
@using Microsoft.AspNetCore.WebUtilities
@inject IOptions<AuthFacadeOptions> AuthFacadeOptions

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="login-page">
    <MudPaper Elevation="2" Class="pa-8 d-flex flex-column align-center ga-4">
        <MudText Typo="Typo.h4" HtmlTag="h1">OpenEMR Next</MudText>

        @if (ErrorMessage is { } message)
        {
            <MudAlert Severity="Severity.Error" role="alert" Class="w-100">@message</MudAlert>
        }
        else if (LoginSucceeded)
        {
            <MudAlert Severity="Severity.Success" role="status" Class="w-100">Login successful.</MudAlert>
        }

        <MudText>Sign in with your existing OpenEMR account.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@LoginUrl">Log in with OpenEMR</MudButton>
    </MudPaper>
</MudContainer>

@code {
    /// <summary>
    /// Where AuthFacade should send the browser after a successful login. Forwarded to AuthFacade's
    /// <c>/oidc/login</c> endpoint unchanged; AuthFacade is the one that validates it against its own
    /// allow-list before use (ADR 0024's <c>ReturnUrlValidator</c>, reused by ADR 0026).
    /// </summary>
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    /// <summary>
    /// The error code AuthFacade's <c>/callback</c> appends when the OpenIddict-driven login did not
    /// complete (ADR 0026): currently always <c>login_failed</c>, since that flow does not yet distinguish
    /// why. Set only when <c>/callback</c> redirected back here after a failure.
    /// </summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    /// <summary>
    /// Set when <c>/callback</c> redirected back here after a successful login — only possible when this
    /// page itself supplied the <c>returnUrl</c> below, since AuthFacade never adds this on its own.
    /// </summary>
    [SupplyParameterFromQuery(Name = "login")]
    public string? LoginStatus { get; set; }

    private string LoginUrl
    {
        get
        {
            var baseUrl = AuthFacadeOptions.Value.BaseUrl.TrimEnd('/');
            // When nothing upstream gave us a returnUrl -- the common case, since /logout always lands
            // here with none (LogoutEndpoints.cs) -- send a successful login on to WebApp's dashboard
            // instead of back to this bare page, which has no nav chrome of its own once signed in.
            // WebApp shares this same origin through the gateway (ADR 0032), so baseUrl already is its
            // address too. A failed callback appends "error" to this same URL (OpenIddictClientEndpoints.cs);
            // Home.razor shows it the same way ErrorMessage does here.
            var returnUrl = string.IsNullOrEmpty(ReturnUrl) ? $"{baseUrl}/" : ReturnUrl;
            return QueryHelpers.AddQueryString($"{baseUrl}/oidc/login", "returnUrl", returnUrl);
        }
    }

    /// <summary>
    /// A message safe to show for <see cref="Error"/>. Any value, recognized or not, gets the same generic
    /// message — AuthFacade's own error text is never echoed to the browser.
    /// </summary>
    private string? ErrorMessage => string.IsNullOrEmpty(Error)
        ? null
        : "Something went wrong signing in. Please try again.";

    private bool LoginSucceeded => LoginStatus == "success";
}
