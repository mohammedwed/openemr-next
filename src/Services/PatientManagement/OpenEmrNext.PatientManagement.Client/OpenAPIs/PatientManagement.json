{
  "openapi": "3.1.1",
  "info": {
    "title": "PatientManagement API",
    "description": "Patient registration, insurance, advance directives, and the FHIR Patient API. Every endpoint requires the shared X-Internal-Gateway-Secret header (ADR 0055) -- there is no per-user authentication yet; see that ADR for why.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/patients": {
      "post": {
        "tags": [
          "Patients"
        ],
        "summary": "Register a new patient",
        "operationId": "RegisterPatient",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterPatientRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientRegisteredResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalGateway": []
          }
        ]
      }
    },
    "/api/v1/patients/{pid}/insurance": {
      "post": {
        "tags": [
          "Insurance"
        ],
        "summary": "Add a new insurance policy for a patient",
        "operationId": "AddInsurancePolicy",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddInsurancePolicyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InsurancePolicyAddedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalGateway": []
          }
        ]
      }
    },
    "/api/v1/patients/{pid}/insurance/effective": {
      "get": {
        "tags": [
          "Insurance"
        ],
        "summary": "Get the insurance policy in force at each level, on a given day",
        "operationId": "GetEffectiveInsurance",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "day",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EffectiveInsuranceResponse"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalGateway": []
          }
        ]
      }
    },
    "/api/v1/patients/{pid}/insurance/swap": {
      "post": {
        "tags": [
          "Insurance"
        ],
        "summary": "Swap which level a policy occupies with whatever currently occupies the target level",
        "operationId": "SwapInsurance",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SwapInsuranceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalGateway": []
          }
        ]
      }
    },
    "/api/v1/patients/{pid}/advance-directives/documents": {
      "post": {
        "tags": [
          "AdvanceDirectives"
        ],
        "summary": "Upload an advance directive document for a patient",
        "operationId": "UploadAdvanceDirectiveDocument",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadAdvanceDirectiveDocumentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdvanceDirectiveDocumentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalGateway": []
          }
        ]
      },
      "get": {
        "tags": [
          "AdvanceDirectives"
        ],
        "summary": "List a patient's advance directive documents",
        "operationId": "GetAdvanceDirectiveDocuments",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AdvanceDirectiveDocumentResponse"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalGateway": []
          }
        ]
      }
    },
    "/api/v1/patients/{pid}/advance-directives/documents/{uuid}/content": {
      "get": {
        "tags": [
          "AdvanceDirectives"
        ],
        "summary": "Download an advance directive document's file content",
        "operationId": "DownloadAdvanceDirectiveDocumentContent",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "security": [
          {
            "InternalGateway": []
          }
        ]
      }
    },
    "/api/v1/patients/{pid}/advance-directives/status": {
      "put": {
        "tags": [
          "AdvanceDirectives"
        ],
        "summary": "Set whether a patient has completed an advance directive, and who reviewed it",
        "operationId": "SetAdvanceDirectiveStatus",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetAdvanceDirectiveStatusRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalGateway": []
          }
        ]
      },
      "get": {
        "tags": [
          "AdvanceDirectives"
        ],
        "summary": "Get a patient's advance directive status",
        "operationId": "GetAdvanceDirectiveStatus",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdvanceDirectiveStatusResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalGateway": []
          }
        ]
      }
    },
    "/fhir/Patient/{uuid}": {
      "get": {
        "tags": [
          "Fhir"
        ],
        "summary": "Read a patient as a FHIR R4 Patient resource",
        "operationId": "FhirGetPatient",
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/fhir+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        },
        "security": [
          {
            "InternalGateway": []
          }
        ]
      }
    },
    "/fhir/Patient": {
      "get": {
        "tags": [
          "Fhir"
        ],
        "summary": "Search patients, returning a FHIR searchset Bundle",
        "operationId": "FhirSearchPatients",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/fhir+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalGateway": []
          }
        ]
      },
      "post": {
        "tags": [
          "Fhir"
        ],
        "summary": "Create a patient from a FHIR R4 Patient resource",
        "operationId": "FhirCreatePatient",
        "parameters": [
          {
            "name": "registeredBy",
            "in": "query",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int64"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/fhir+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/fhir+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalGateway": []
          }
        ]
      }
    },
    "/fhir/Patient/$validate": {
      "post": {
        "tags": [
          "Fhir"
        ],
        "summary": "Validate a FHIR R4 Patient resource against the real US Core Patient profile",
        "operationId": "FhirValidatePatient",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/fhir+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/fhir+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalGateway": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AddInsurancePolicyRequest": {
        "required": [
          "level",
          "companyId",
          "policyNumber",
          "groupNumber",
          "planName",
          "startDate",
          "endDate"
        ],
        "type": "object",
        "properties": {
          "level": {
            "type": "string"
          },
          "companyId": {
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "policyNumber": {
            "maxLength": 255,
            "minLength": 2,
            "type": "string"
          },
          "groupNumber": {
            "maxLength": 255,
            "minLength": 2,
            "type": [
              "null",
              "string"
            ]
          },
          "planName": {
            "maxLength": 255,
            "minLength": 2,
            "type": [
              "null",
              "string"
            ]
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "AdvanceDirectiveDocumentResponse": {
        "required": [
          "id",
          "uuid",
          "type",
          "name",
          "mimeType",
          "size",
          "effectiveDate",
          "ownerId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "name": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "size": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "effectiveDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "ownerId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "AdvanceDirectiveStatusResponse": {
        "required": [
          "status",
          "reviewedAtUtc",
          "authenticatorUserId"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "reviewedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "authenticatorUserId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "EffectiveInsuranceResponse": {
        "required": [
          "level",
          "id",
          "uuid",
          "companyId",
          "start",
          "end"
        ],
        "type": "object",
        "properties": {
          "level": {
            "type": "string"
          },
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "uuid": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "companyId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "start": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "end": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "InsurancePolicyAddedResponse": {
        "required": [
          "uuid",
          "id",
          "level",
          "companyId",
          "policyNumber",
          "startDate",
          "endDate"
        ],
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "level": {
            "type": "string"
          },
          "companyId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "policyNumber": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "PatientRegisteredResponse": {
        "required": [
          "uuid",
          "pid",
          "pubpid"
        ],
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "pid": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "pubpid": {
            "type": "string"
          }
        }
      },
      "RegisterPatientRequest": {
        "required": [
          "firstName",
          "lastName",
          "sex",
          "dateOfBirth",
          "email",
          "trustedEmail",
          "registeredBy"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "maxLength": 255,
            "minLength": 2,
            "type": "string"
          },
          "sex": {
            "maxLength": 30,
            "minLength": 4,
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "email": {
            "type": [
              "null",
              "string"
            ],
            "format": "email"
          },
          "trustedEmail": {
            "type": [
              "null",
              "string"
            ],
            "format": "email"
          },
          "registeredBy": {
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "SetAdvanceDirectiveStatusRequest": {
        "required": [
          "status",
          "reviewedAtUtc",
          "authenticatorUserId"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "reviewedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "authenticatorUserId": {
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "SwapInsuranceRequest": {
        "required": [
          "targetLevel",
          "policyUuid"
        ],
        "type": "object",
        "properties": {
          "targetLevel": {
            "type": "string"
          },
          "policyUuid": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "UploadAdvanceDirectiveDocumentRequest": {
        "required": [
          "type",
          "fileName",
          "mimeType",
          "contentBase64",
          "effectiveDate",
          "ownerId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "fileName": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "contentBase64": {
            "type": "string"
          },
          "effectiveDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "ownerId": {
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      }
    },
    "securitySchemes": {
      "InternalGateway": {
        "type": "apiKey",
        "description": "The shared secret configured by InternalGatewayOptions.Secret. Gates the service shut to anyone else; it does not identify which end user is behind the call.",
        "name": "X-Internal-Gateway-Secret",
        "in": "header"
      }
    }
  },
  "tags": [
    {
      "name": "Patients"
    },
    {
      "name": "Insurance"
    },
    {
      "name": "AdvanceDirectives"
    },
    {
      "name": "Fhir"
    }
  ]
}
