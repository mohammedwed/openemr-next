@inherits LayoutComponentBase
@implements IDisposable
@inject IAuthFacadeClient AuthFacade
@inject NavigationManager Navigation

<MudLayout>
    @* Elevation 0 + a hairline border, not a shadow: a flat, light app bar reads closer to the plain
       Blazor template's chrome than a shadowed, solid-brand-color bar did. *@
    <MudAppBar Elevation="0" Class="op-appbar">
        <MudText Typo="Typo.h6" Class="op-brand">OpenEMR Next</MudText>
        <MudSpacer />
        @* A flat inline nav, not a persistent MudDrawer sidebar: with only two enabled routes, an
           always-visible side rail added chrome weight without adding navigability. *@
        <nav class="op-nav">
            <NavLink href="" Match="NavLinkMatch.All" class="op-nav-link">Dashboard</NavLink>
            <NavLink href="patients" class="op-nav-link">Patients</NavLink>
            <MudTooltip Text="Coming soon">
                <span class="op-nav-link op-nav-link--disabled">Encounters</span>
            </MudTooltip>
        </nav>
        <MudSpacer />
        @if (_userLabel is { } userLabel)
        {
            <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit">
                <MudMenuItem Disabled="true">Signed in as @userLabel</MudMenuItem>
                <MudDivider />
                <MudMenuItem Href="/logout">Log out</MudMenuItem>
            </MudMenu>
        }
    </MudAppBar>
    @* px-4/pb-4, not pa-4: pa-4's padding: 16px !important overrides MudMainContent's own
       padding-top: calc(var(--mud-appbar-height) - ...) -- the rule that clears the fixed app bar.
       With pa-4, every page's top content (headers, primary buttons) rendered ~40px too high,
       hidden underneath the app bar -- confirmed by inspecting the actual computed styles and
       CSS rules in a running browser, not guessed. Leaving padding-top alone lets that rule apply. *@
    <MudMainContent Class="px-4 pb-4">
        <MudBreadcrumbs Items="_breadcrumbs" Class="op-breadcrumbs px-0" />
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private string? _userLabel;
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        BuildBreadcrumbs();

        try
        {
            var me = await AuthFacade.GetCurrentUserAsync();
            // OpenEMR's tokens in this stack carry no name claim (docs/m4-domain-notes.md), so Name is
            // reliably empty for a real user -- the same gap Home.razor's own display already has.
            // Falling back to a shortened subject (its UUID) keeps the menu meaningful either way.
            _userLabel = string.IsNullOrEmpty(me.Name) ? me.Subject[..Math.Min(8, me.Subject.Length)] : me.Name;
        }
        catch (ApiException)
        {
            _userLabel = null;
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        BuildBreadcrumbs();
        StateHasChanged();
    }

    /// <summary>
    /// A plain path-segment mapping, not a per-page cascading value: this app has few enough routes
    /// that a shared source of truth isn't worth the extra plumbing yet. Revisit if the route list
    /// grows past what a simple switch can read at a glance.
    /// </summary>
    private void BuildBreadcrumbs()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath.Trim('/');
        var segments = path.Length == 0 ? [] : path.Split('/');

        _breadcrumbs = segments switch
        {
            [] => [new BreadcrumbItem("Dashboard", href: "/")],
            ["patients"] => [new BreadcrumbItem("Patients", href: null)],
            ["patients", "register"] =>
            [
                new BreadcrumbItem("Patients", href: "/patients"),
                new BreadcrumbItem("Register", href: null)
            ],
            ["patients", _] =>
            [
                new BreadcrumbItem("Patients", href: "/patients"),
                new BreadcrumbItem("Patient", href: null)
            ],
            _ => []
        };
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
