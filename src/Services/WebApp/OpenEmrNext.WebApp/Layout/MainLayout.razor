@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">OpenEMR Next</MudText>
    </MudAppBar>
    <MudDrawer Open="true" Elevation="1" Variant="DrawerVariant.Persistent">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Disabled="true" Icon="@Icons.Material.Filled.People">
                Patients
                <MudText Typo="Typo.caption" Class="ml-2">Coming soon</MudText>
            </MudNavLink>
            <MudNavLink Disabled="true" Icon="@Icons.Material.Filled.EventNote">
                Encounters
                <MudText Typo="Typo.caption" Class="ml-2">Coming soon</MudText>
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>
