<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.12.0" />
    <!-- For AuthFacadeCircuitBreakingHandler's ResiliencePipelineBuilder/CircuitBreakerStrategyOptions
         (Polly v8 APIs), the same version AuthFacade.Api's own circuit breakers (ADR 0041) resolve to. -->
    <PackageReference Include="Polly.Core" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AuthFacade\OpenEmrNext.AuthFacade.Client\OpenEmrNext.AuthFacade.Client.csproj" />
  </ItemGroup>

</Project>
