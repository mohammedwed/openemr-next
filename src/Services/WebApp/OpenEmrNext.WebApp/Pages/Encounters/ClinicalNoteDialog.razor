@using OpenEmrNext.ClinicalCare.Client
@using OpenEmrNext.WebApp.Shared
@using ClinicalCareApiException = OpenEmrNext.ClinicalCare.Client.ApiException
@inject IClinicalCareClient ClinicalCare

@* One dialog for recording a clinical note and for editing one: the fields are the same, and a correction replaces the whole set (a category you clear is removed). The type and category are chosen from
   the configured lists, which the dialog loads when it opens; without them a note cannot be saved, because its type must be one of them. A note whose type has since been retired is still shown and kept. It
   closes only when the save succeeds, or the note turns out to be stale (which hands back a marker so the list reloads). *@
<MudDialog>
    <DialogContent>
        @if (_error is { } error)
        {
            <MudAlert Severity="@(_stale ? Severity.Warning : Severity.Error)" Variant="Variant.Outlined" Dense="true" Class="mb-4" role="alert">@error</MudAlert>
        }
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" role="status" aria-label="Loading note types" />
        }
        <MudForm @ref="_form" Model="_model">
            <MudStack Spacing="4" Class="@(_loading ? "op-hidden" : null)">
                <MudSelect T="string" @bind-Value="_model.Type" Label="Type" Required="true" RequiredError="Choose a note type." Variant="Variant.Outlined">
                    @foreach (var option in _types)
                    {
                        <MudSelectItem Value="@option.Id">@option.Title</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string" @bind-Value="_model.Category" Label="Category (optional)" Clearable="true" Variant="Variant.Outlined">
                    @foreach (var option in _categories)
                    {
                        <MudSelectItem Value="@option.Id">@option.Title</MudSelectItem>
                    }
                </MudSelect>

                <MudDatePicker @bind-Date="_model.Date" Label="Date" Required="true" RequiredError="A date is required." Editable="true" Variant="Variant.Outlined"
                    MinDate="MinDate" MaxDate="MaxDate" />

                @* The service's own rule (CN-1): at least two characters; the limit of 65,535 is in bytes, so it is the service that decides. *@
                <MudTextField @bind-Value="_model.Description" Label="Note" Required="true" RequiredError="A note is required." Validation="_validateDescription"
                    Variant="Variant.Outlined" Lines="6" Sizing="InputSizing.Auto" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        @if (_stale)
        {
            @* The note changed under the user: saving again would fail the same way. Close and reload is the only useful next step. *@
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseStale">Close and reload</MudButton>
        }
        else
        {
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="@(_saving || _loading || _types.Count == 0)">@(Existing is null ? "Record note" : "Save changes")</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    // The service's own bounds (CN-4): 1900-01-01 up to tomorrow.
    private static readonly DateTime MinDate = new(1900, 1, 1);
    private static DateTime MaxDate => DateTime.Today.AddDays(1);

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid EncounterUuid { get; set; }

    /// <summary>The note to edit, as listed (it carries the version the correction must be based on). <c>null</c> records a new note.</summary>
    [Parameter] public ClinicalNoteResponse? Existing { get; set; }

    private readonly Func<string?, string?> _validateDescription = v => string.IsNullOrWhiteSpace(v) || v.Trim().Length >= 2 ? null : "Description must be at least 2 characters.";

    private MudForm _form = null!;
    private readonly Model _model = new();
    private bool _loading = true;
    private bool _saving;
    private bool _stale;
    private string? _error;

    private List<(string Id, string Title)> _types = [];
    private List<(string Id, string Title)> _categories = [];

    protected override async Task OnInitializedAsync()
    {
        if (Existing is { } note)
        {
            _model.Type = note.Type;
            _model.Category = note.Category;
            _model.Date = IssueWire.FromWire(note.Date).Date;
            _model.Description = note.Description;
        }
        else
        {
            _model.Date = DateTime.Today;
        }

        try
        {
            _types = (await ClinicalCare.ListClinicalNoteTypesAsync()).Select(t => (t.Id, t.Title)).ToList();
            _categories = (await ClinicalCare.ListClinicalNoteCategoriesAsync()).Select(c => (c.Id, c.Title)).ToList();

            // A type or category the note already has but legacy no longer offers: keep it selectable, so editing the text does not silently change the type.
            if (Existing?.Type is { Length: > 0 } type && _types.All(t => t.Id != type))
            {
                _types.Add((type, $"{Existing.CodeText ?? type} (no longer offered)"));
            }

            if (Existing?.Category is { Length: > 0 } category && _categories.All(c => c.Id != category))
            {
                _categories.Add((category, $"{category} (no longer offered)"));
            }

            if (_types.Count == 0)
            {
                _error = "No note types are configured, so a note cannot be recorded.";
            }
        }
        catch (Exception ex) when (ex is ClinicalCareApiException or HttpRequestException)
        {
            _error = "Could not load the note types and categories, so this note cannot be saved. Close this and try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void CloseStale() => MudDialog.Close(DialogResult.Ok(IssueDialogResult.OutOfDate()));

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            // The same calendar date at offset zero (see IssueWire): a note's date is a day, and must not shift with the browser's zone.
            var date = IssueWire.ToWire(_model.Date, TimeSpan.Zero);

            if (Existing is null)
            {
                await ClinicalCare.RecordClinicalNoteAsync(EncounterUuid, new RecordClinicalNoteRequest
                {
                    Type = _model.Type,
                    Category = Blank(_model.Category),
                    Description = _model.Description,
                    Date = date
                });
            }
            else
            {
                await ClinicalCare.CorrectClinicalNoteAsync(EncounterUuid, Existing.Uuid, Existing.ETag, new CorrectClinicalNoteRequest
                {
                    Type = _model.Type,
                    Category = Blank(_model.Category),
                    Description = _model.Description,
                    Date = date
                });
            }

            MudDialog.Close(DialogResult.Ok(IssueDialogResult.Saved("clinical note", isNew: Existing is null)));
        }
        catch (ClinicalCareApiException ex)
        {
            _stale = ClinicalCareErrorFormatter.IsStale(ex);
            _error = ClinicalCareErrorFormatter.Describe(ex, Existing is null
                ? "Could not record this note. Please check the details and try again."
                : "Could not save this note. Please check the details and try again.");
        }
        catch (HttpRequestException)
        {
            _error = "Could not reach the clinical care service. Nothing was saved. Check your connection, then try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private sealed class Model
    {
        public string? Type { get; set; }
        public string? Category { get; set; }
        public DateTime? Date { get; set; }
        public string? Description { get; set; }
    }
}
