@using OpenEmrNext.ClinicalCare.Client
@using OpenEmrNext.WebApp.Pages.Patients
@using OpenEmrNext.WebApp.Shared
@using ClinicalCareApiException = OpenEmrNext.ClinicalCare.Client.ApiException
@inject IClinicalCareClient ClinicalCare
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* One card for an encounter's clinical notes (M5d), built like the SOAP notes panel: it loads its own server-paged list (API-6), a failed page change keeps the last page with a warning, and an edit is based on
   the version the row was listed with, so a note changed elsewhere in the meantime is refused and the list reloads. Retiring a note is a delete and is not offered (it needs the permission port). *@
<PatientSectionCard Title="Clinical notes"
    HasData="_items is not null" Error="_error" OnRetry="LoadAsync"
    ErrorMessage="Could not load clinical notes. The clinical care service may be unavailable."
    StaleMessage="Could not refresh clinical notes. The list below may be out of date."
    LoadingLabel="Loading clinical notes">
    <Summary>
        <MudText Typo="Typo.body2" Class="mud-text-secondary" role="status">
            @(_total == 1 ? "1 note" : $"{_total} notes")@(_total > PageSize ? $" · page {_page} of {PageCount}" : "")
        </MudText>
    </Summary>
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenRecordAsync">Record clinical note</MudButton>
    </Actions>
    <ChildContent>
        <MudTable Items="_items ?? []" Hover="true" Elevation="0" Dense="true"
            TableAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Clinical notes" })">
            <HeaderContent>
                <MudTh>Date</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Note</MudTh>
                <MudTh><span class="op-visually-hidden">Actions</span></MudTh>
            </HeaderContent>
            <RowTemplate Context="note">
                <MudTd DataLabel="Date">
                    <div>@Formatting.DateText(note.Date)</div>
                    @if (!string.IsNullOrWhiteSpace(note.RecordedBy))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">by @note.RecordedBy</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Type">
                    <div>@(string.IsNullOrWhiteSpace(note.CodeText) ? (note.Type ?? "—") : note.CodeText)</div>
                    @if (!string.IsNullOrWhiteSpace(note.Category))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@note.Category</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Note"><span class="op-prewrap">@(string.IsNullOrWhiteSpace(note.Description) ? "—" : note.Description)</span></MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditAsync(note))"
                        aria-label="@($"Edit the clinical note of {Formatting.DateText(note.Date)}")">Edit</MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudStack Spacing="2" AlignItems="AlignItems.Start" Class="py-2">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No clinical notes recorded for this encounter yet.</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="OpenRecordAsync">Record the first note</MudButton>
                </MudStack>
            </NoRecordsContent>
        </MudTable>

        @if (PageCount > 1)
        {
            <MudStack AlignItems="AlignItems.Center" Class="mt-4">
                <MudPagination Count="PageCount" Selected="_page" SelectedChanged="OnPageChangedAsync"
                    ShowFirstButton="true" ShowLastButton="true" Disabled="_loading" aria-label="Clinical note pages" />
            </MudStack>
        }
    </ChildContent>
</PatientSectionCard>

@code {
    private const int PageSize = 10;

    [Parameter, EditorRequired] public Guid EncounterUuid { get; set; }

    private List<ClinicalNoteResponse>? _items;
    private int _total;
    private int _page = 1;
    private bool _error;
    private bool _loading;
    private int _loadCounter;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_total / (double)PageSize));

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task OnPageChangedAsync(int page) => LoadAsync(page);

    private Task LoadAsync() => LoadAsync(_page);

    private async Task LoadAsync(int page)
    {
        var ticket = ++_loadCounter;
        _loading = true;
        try
        {
            var result = await ClinicalCare.ListClinicalNotesAsync(EncounterUuid, PageSize, (page - 1) * PageSize);
            if (ticket != _loadCounter)
            {
                return; // a newer load has started since this one
            }

            _items = [.. result.Items];
            _total = result.Total;
            _page = page;
            _error = false;
        }
        catch (Exception ex) when (ex is ClinicalCareApiException or HttpRequestException)
        {
            if (ticket == _loadCounter)
            {
                _error = true;
            }
        }
        finally
        {
            if (ticket == _loadCounter)
            {
                _loading = false;
            }
        }
    }

    private Task OpenRecordAsync() => ShowAsync("Record clinical note", null);

    private Task OpenEditAsync(ClinicalNoteResponse note) => ShowAsync("Edit clinical note", note);

    private async Task ShowAsync(string title, ClinicalNoteResponse? existing)
    {
        var parameters = new DialogParameters<ClinicalNoteDialog> { { x => x.EncounterUuid, EncounterUuid }, { x => x.Existing, existing } };
        var dialog = await DialogService.ShowAsync<ClinicalNoteDialog>(title, parameters, DialogDefaults.Standard);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: IssueDialogResult saved })
        {
            return;
        }

        Snackbar.Add(
            saved.Stale
                ? "That note was changed by someone else (or no longer exists), so nothing was saved. The list now shows what is stored."
                : saved.IsNew ? "Clinical note recorded." : "Clinical note saved.",
            saved.Stale ? Severity.Warning : Severity.Success);

        await LoadAsync(saved.IsNew ? 1 : _page);
    }
}
