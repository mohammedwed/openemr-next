@using OpenEmrNext.ClinicalCare.Client
@using OpenEmrNext.WebApp.Pages.Patients
@using OpenEmrNext.WebApp.Shared
@using ClinicalCareApiException = OpenEmrNext.ClinicalCare.Client.ApiException
@inject IClinicalCareClient ClinicalCare
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* One card for an encounter's SOAP notes (M5d). Like the vitals panel it loads its own pages (the API is server-paged, API-6). A failed first load shows an error with "Try again"; a failed page change keeps the
   last page on screen with a warning, so a note is never replaced by an empty screen. An edit is based on the version the row was listed with: if someone changed the note in the meantime the save is
   refused and the list reloads. A note has no delete here (it needs the permission port). *@
<PatientSectionCard Title="SOAP notes"
    HasData="_items is not null" Error="_error" OnRetry="LoadAsync"
    ErrorMessage="Could not load SOAP notes. The clinical care service may be unavailable."
    StaleMessage="Could not refresh SOAP notes. The list below may be out of date."
    LoadingLabel="Loading SOAP notes">
    <Summary>
        <MudText Typo="Typo.body2" Class="mud-text-secondary" role="status">
            @(_total == 1 ? "1 note" : $"{_total} notes")@(_total > PageSize ? $" · page {_page} of {PageCount}" : "")
        </MudText>
    </Summary>
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenRecordAsync">Record SOAP note</MudButton>
    </Actions>
    <ChildContent>
        <MudTable Items="_items ?? []" Hover="true" Elevation="0" Dense="true"
            TableAttributes="@(new Dictionary<string, object> { ["aria-label"] = "SOAP notes" })">
            <HeaderContent>
                <MudTh>Written</MudTh>
                <MudTh>Note</MudTh>
                <MudTh><span class="op-visually-hidden">Actions</span></MudTh>
            </HeaderContent>
            <RowTemplate Context="note">
                <MudTd DataLabel="Written">
                    <div>@Formatting.DateTimeText(note.Date)</div>
                    @if (!string.IsNullOrWhiteSpace(note.RecordedBy))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">by @note.RecordedBy</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Note">
                    @* Each section that has text, labelled, in the order the note is read. Whitespace is the clinician's, so it is kept. *@
                    @foreach (var (label, text) in Sections(note))
                    {
                        <div class="mb-1"><strong>@label:</strong> <span class="op-prewrap">@text</span></div>
                    }
                </MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditAsync(note))"
                        aria-label="@($"Edit the SOAP note written {Formatting.DateTimeText(note.Date)}")">Edit</MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudStack Spacing="2" AlignItems="AlignItems.Start" Class="py-2">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No SOAP notes recorded for this encounter yet.</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="OpenRecordAsync">Record the first note</MudButton>
                </MudStack>
            </NoRecordsContent>
        </MudTable>

        @if (PageCount > 1)
        {
            <MudStack AlignItems="AlignItems.Center" Class="mt-4">
                <MudPagination Count="PageCount" Selected="_page" SelectedChanged="OnPageChangedAsync"
                    ShowFirstButton="true" ShowLastButton="true" Disabled="_loading" aria-label="SOAP note pages" />
            </MudStack>
        }
    </ChildContent>
</PatientSectionCard>

@code {
    private const int PageSize = 10;

    [Parameter, EditorRequired] public Guid EncounterUuid { get; set; }

    // Null means "not loaded yet". A failed page change keeps the previous page here on purpose.
    private List<SoapNoteResponse>? _items;
    private int _total;
    private int _page = 1;
    private bool _error;
    private bool _loading;

    // Each load takes a number; only the latest one may apply its result, so a slow response for an earlier page can never overwrite a newer one.
    private int _loadCounter;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_total / (double)PageSize));

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task OnPageChangedAsync(int page) => LoadAsync(page);

    private Task LoadAsync() => LoadAsync(_page);

    private async Task LoadAsync(int page)
    {
        var ticket = ++_loadCounter;
        _loading = true;
        try
        {
            var result = await ClinicalCare.ListSoapNotesAsync(EncounterUuid, PageSize, (page - 1) * PageSize);
            if (ticket != _loadCounter)
            {
                return; // a newer load has started since this one
            }

            _items = [.. result.Items];
            _total = result.Total;
            _page = page;
            _error = false;
        }
        catch (Exception ex) when (ex is ClinicalCareApiException or HttpRequestException)
        {
            if (ticket == _loadCounter)
            {
                _error = true;
            }
        }
        finally
        {
            if (ticket == _loadCounter)
            {
                _loading = false;
            }
        }
    }

    private static IEnumerable<(string Label, string Text)> Sections(SoapNoteResponse note)
    {
        if (!string.IsNullOrWhiteSpace(note.Subjective)) yield return ("Subjective", note.Subjective);
        if (!string.IsNullOrWhiteSpace(note.Objective)) yield return ("Objective", note.Objective);
        if (!string.IsNullOrWhiteSpace(note.Assessment)) yield return ("Assessment", note.Assessment);
        if (!string.IsNullOrWhiteSpace(note.Plan)) yield return ("Plan", note.Plan);
    }

    private Task OpenRecordAsync() => ShowAsync("Record SOAP note", null);

    private Task OpenEditAsync(SoapNoteResponse note) => ShowAsync("Edit SOAP note", note);

    private async Task ShowAsync(string title, SoapNoteResponse? existing)
    {
        var parameters = new DialogParameters<SoapNoteDialog> { { x => x.EncounterUuid, EncounterUuid }, { x => x.Existing, existing } };
        var dialog = await DialogService.ShowAsync<SoapNoteDialog>(title, parameters, DialogDefaults.Standard);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: IssueDialogResult saved })
        {
            return;
        }

        Snackbar.Add(
            saved.Stale
                ? "That note was changed by someone else (or no longer exists), so nothing was saved. The list now shows what is stored."
                : saved.IsNew ? "SOAP note recorded." : "SOAP note saved.",
            saved.Stale ? Severity.Warning : Severity.Success);

        // Newest first, so a new note is on page 1; a stale refusal reloads the current page to show what is stored now.
        await LoadAsync(saved.IsNew ? 1 : _page);
    }
}
