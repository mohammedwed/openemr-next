@using OpenEmrNext.ClinicalCare.Client
@using OpenEmrNext.WebApp.Shared
@using ClinicalCareApiException = OpenEmrNext.ClinicalCare.Client.ApiException
@inject IClinicalCareClient ClinicalCare
@inject OpenEmrNext.WebApp.Shared.IdempotencyAttempt Attempt

@* One dialog for recording a SOAP note and for editing one: the four sections are the same, and a correction replaces the whole set (a section you clear is removed). It closes only when the save
   succeeds, or the note turns out to be stale (which hands back a marker so the list reloads); on any other failure it stays open with the typed text intact. At least one section is required (SN-1). *@
<MudDialog>
    <DialogContent>
        @if (_error is { } error)
        {
            <MudAlert Severity="@(_stale ? Severity.Warning : Severity.Error)" Variant="Variant.Outlined" Dense="true" Class="mb-4" role="alert">@error</MudAlert>
        }
        <MudForm @ref="_form" Model="_model">
            <MudStack Spacing="4">
                @* The service's own rule (SN-2), with its wording: a section that is given has at least two characters. The limit of 65,535 is in bytes, so it is the service that decides. *@
                <MudTextField @bind-Value="_model.Subjective" Label="Subjective" Validation="_validateSection" Variant="Variant.Outlined"
                    Lines="3" Sizing="InputSizing.Auto" HelperText="What the patient reports." />
                <MudTextField @bind-Value="_model.Objective" Label="Objective" Validation="_validateSection" Variant="Variant.Outlined"
                    Lines="3" Sizing="InputSizing.Auto" HelperText="What was observed and measured." />
                <MudTextField @bind-Value="_model.Assessment" Label="Assessment" Validation="_validateSection" Variant="Variant.Outlined"
                    Lines="3" Sizing="InputSizing.Auto" HelperText="The clinician's assessment." />
                <MudTextField @bind-Value="_model.Plan" Label="Plan" Validation="_validateSection" Variant="Variant.Outlined"
                    Lines="3" Sizing="InputSizing.Auto" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        @if (_stale)
        {
            @* The note changed under the user: saving again would fail the same way. Close and reload is the only useful next step. *@
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseStale">Close and reload</MudButton>
        }
        else
        {
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_saving">@(Existing is null ? "Record note" : "Save changes")</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid EncounterUuid { get; set; }

    /// <summary>The note to edit, as listed (it carries the version the correction must be based on). <c>null</c> records a new note.</summary>
    [Parameter] public SoapNoteResponse? Existing { get; set; }

    private readonly Func<string?, string?> _validateSection = v => string.IsNullOrWhiteSpace(v) || v.Trim().Length >= 2 ? null : "A section must be at least 2 characters.";

    private MudForm _form = null!;
    private readonly Model _model = new();
    private bool _saving;
    private bool _stale;
    private string? _error;

    protected override void OnInitialized()
    {
        if (Existing is { } note)
        {
            _model.Subjective = note.Subjective;
            _model.Objective = note.Objective;
            _model.Assessment = note.Assessment;
            _model.Plan = note.Plan;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void CloseStale() => MudDialog.Close(DialogResult.Ok(IssueDialogResult.OutOfDate()));

    private async Task SubmitAsync()
    {
        _error = null;
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        if (!_model.HasText)
        {
            _error = "At least one section of the note is required.";
            return;
        }

        _saving = true;
        try
        {
            if (Existing is null)
            {
                // A retried save is one request, not two: the attempt lives until a save succeeds (ADR 0077).
                Attempt.BeginIfNone();
                await ClinicalCare.RecordSoapNoteAsync(EncounterUuid, new RecordSoapNoteRequest
                {
                    Subjective = Blank(_model.Subjective),
                    Objective = Blank(_model.Objective),
                    Assessment = Blank(_model.Assessment),
                    Plan = Blank(_model.Plan)
                });
            }
            else
            {
                await ClinicalCare.CorrectSoapNoteAsync(EncounterUuid, Existing.Id, Existing.ETag, new CorrectSoapNoteRequest
                {
                    Subjective = Blank(_model.Subjective),
                    Objective = Blank(_model.Objective),
                    Assessment = Blank(_model.Assessment),
                    Plan = Blank(_model.Plan)
                });
            }

            MudDialog.Close(DialogResult.Ok(IssueDialogResult.Saved("SOAP note", isNew: Existing is null)));
        }
        catch (ClinicalCareApiException ex)
        {
            _stale = ClinicalCareErrorFormatter.IsStale(ex);
            _error = ClinicalCareErrorFormatter.Describe(ex, Existing is null
                ? "Could not record this note. Please check the text and try again."
                : "Could not save this note. Please check the text and try again.");
        }
        catch (HttpRequestException)
        {
            _error = "Could not reach the clinical care service. Nothing was saved. Check your connection, then try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private sealed class Model
    {
        public string? Subjective { get; set; }
        public string? Objective { get; set; }
        public string? Assessment { get; set; }
        public string? Plan { get; set; }

        public bool HasText =>
            !string.IsNullOrWhiteSpace(Subjective) || !string.IsNullOrWhiteSpace(Objective) || !string.IsNullOrWhiteSpace(Assessment) || !string.IsNullOrWhiteSpace(Plan);
    }
}
