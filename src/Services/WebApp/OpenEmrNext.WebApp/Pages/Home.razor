@page "/"
@inject IAuthFacadeClient AuthFacade
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
    <MudText Typo="Typo.h5" Class="mb-6">Dashboard</MudText>

    @switch (_state)
    {
        case State.Loading:
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            break;

        case State.SignedIn:
            <MudPaper Elevation="1" Class="pa-6">
                <MudStack Spacing="4">
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Signed in as</MudText>
                        <MudText Typo="Typo.h6">@_name</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@_subject</MudText>
                    </div>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        Patient and encounter data isn't built yet (ROADMAP M4/M5) — this page proves the
                        sign-in round trip end to end, through the generated AuthFacadeClient.
                    </MudAlert>
                    <div>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/logout" Size="Size.Small">
                            Log out
                        </MudButton>
                    </div>
                </MudStack>
            </MudPaper>
            break;

        case State.SignedOut:
            <MudPaper Elevation="1" Class="pa-6">
                <MudStack Spacing="4">
                    @if (ErrorMessage is { } message)
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" role="alert">@message</MudAlert>
                    }
                    <MudText Class="mud-text-secondary">Sign in with your existing OpenEMR account.</MudText>
                    <div>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@LoginUrl">
                            Log in with OpenEMR
                        </MudButton>
                    </div>
                </MudStack>
            </MudPaper>
            break;
    }
</MudContainer>

@code {
    private enum State { Loading, SignedIn, SignedOut }

    private State _state = State.Loading;
    private string? _name;
    private string? _subject;

    /// <summary>
    /// The error code AuthFacade's <c>/callback</c> appends when login did not complete (ADR 0026) --
    /// reachable here now that LoginUi defaults a returnUrl-less login's destination to this page
    /// (Login.razor), not just back to itself. Same generic text either way: AuthFacade's own error text
    /// is never echoed to the browser.
    /// </summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string? ErrorMessage => string.IsNullOrEmpty(Error)
        ? null
        : "Something went wrong signing in. Please try again.";

    /// <summary>
    /// Where <c>/oidc/login</c> sends the browser back to after a successful login: this same page. Safe to
    /// pass as an explicit <c>returnUrl</c> because this app is served by AuthFacade itself (ADR 0032), so
    /// its own address is already on <c>BrowserFlow:ReturnUrlAllowedHosts</c>.
    /// </summary>
    private string LoginUrl => $"/oidc/login?returnUrl={Uri.EscapeDataString(Navigation.BaseUri)}";

    /// <summary>
    /// Calls <c>GET /api/v1/me</c> through the generated client. A same-origin request carries the
    /// <c>AuthFacadeSession</c> cookie automatically — no credentials flag or CORS configuration needed,
    /// which is the whole reason this app is hosted from AuthFacade's own origin rather than its own.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var me = await AuthFacade.GetCurrentUserAsync();
            _name = me.Name;
            _subject = me.Subject;
            _state = State.SignedIn;
        }
        catch (ApiException)
        {
            _state = State.SignedOut;
        }
    }
}
