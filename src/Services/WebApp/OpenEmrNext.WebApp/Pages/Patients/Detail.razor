@page "/patients/{Uuid:guid}"
@using OpenEmrNext.PatientManagement.Client
@using OpenEmrNext.WebApp.Shared
@using PatientManagementApiException = OpenEmrNext.PatientManagement.Client.ApiException
@inject IAuthFacadeClient AuthFacade
@inject IPatientManagementClient PatientManagement
@inject NavigationManager Navigation
@inject PatientPageContext PatientPage
@implements IDisposable

<PageTitle>@(_patient is null ? "Patient" : $"{_patient.FirstName} {_patient.LastName}")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-0">
    @switch (_state)
    {
        case State.Loading:
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" role="status" aria-label="Loading patient" />
            break;

        case State.SignedOut:
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                You need to be signed in to see this patient.
                <MudButton Variant="Variant.Text" Color="Color.Warning" Href="@LoginUrl">Log in with OpenEMR</MudButton>
            </MudAlert>
            break;

        case State.NotFound:
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">No patient with that id was found.</MudAlert>
            break;

        case State.Error:
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                Could not load this patient. The patient service may be unavailable.
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadPatientAsync">Try again</MudButton>
            </MudAlert>
            break;

        case State.Ready:
            var patient = _patient!;

            @* Basic information stays on screen above the tabs, so it is never one click away. The tabs
               hold the two areas that are worth opening on demand. Each panel is keyed on the patient, so
               switching patients rebuilds it. *@
            <MudPaper Outlined="true" Class="pa-5 mb-6">
                <MudText Typo="Typo.h4" Class="mb-4">@patient.FirstName @patient.LastName</MudText>
                <dl class="op-details">
                    <dt>Patient ID</dt>
                    <dd>@(patient.PublicPatientId ?? patient.Pid.ToString())</dd>
                    <dt>Date of birth</dt>
                    <dd>@Formatting.DateOfBirthWithAge(patient.DateOfBirth, DateOnly.FromDateTime(DateTime.Today))</dd>
                    <dt>Email</dt>
                    <dd>@(string.IsNullOrWhiteSpace(patient.Email) ? "—" : patient.Email)</dd>
                </dl>
            </MudPaper>

            <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                <MudTabPanel Text="@WithCount("Insurance", _policyCount)">
                    <PatientInsurancePanel @key="patient.Pid" Pid="patient.Pid" Changed="RefreshCountsAsync" />
                </MudTabPanel>

                <MudTabPanel Text="@WithCount("Advance directives", _documentCount)">
                    <PatientAdvanceDirectivesPanel @key="patient.Pid" Pid="patient.Pid" Changed="RefreshCountsAsync" />
                </MudTabPanel>
            </MudTabs>
            break;
    }
</MudContainer>

@code {
    private enum State { Loading, SignedOut, NotFound, Error, Ready }

    [Parameter] public Guid Uuid { get; set; }

    private State _state = State.Loading;
    private PatientSummaryResponse? _patient;
    private Guid? _loadedUuid;

    // Tab counts. Null means "not known" (still loading, or the call failed), and the tab shows no count.
    private int? _policyCount;
    private int? _documentCount;

    private static string WithCount(string label, int? count) => count is null ? label : $"{label} ({count})";

    /// <summary>Re-reads the two counts. Panels call this after a successful change so the tabs stay accurate.</summary>
    private async Task RefreshCountsAsync()
    {
        if (_patient is not { } patient)
        {
            return;
        }

        var pid = patient.Pid;
        try
        {
            var policies = await PatientManagement.GetEffectiveInsuranceAsync(pid, null);
            if (_patient?.Pid == pid)
            {
                _policyCount = policies.Count;
            }
        }
        catch (PatientManagementApiException)
        {
            _policyCount = null;
        }

        try
        {
            var documents = await PatientManagement.GetAdvanceDirectiveDocumentsAsync(pid);
            if (_patient?.Pid == pid)
            {
                _documentCount = documents.Count;
            }
        }
        catch (PatientManagementApiException)
        {
            _documentCount = null;
        }

        StateHasChanged();
    }

    public void Dispose() => PatientPage.PatientName = null;

    private string LoginUrl => $"/oidc/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}";

    /// <summary>
    /// Blazor reuses this page instance when only the route parameter changes (one patient to another),
    /// so loading only on first render would keep showing the previous patient.
    /// </summary>
    protected override Task OnParametersSetAsync()
    {
        if (_loadedUuid == Uuid)
        {
            return Task.CompletedTask;
        }

        _loadedUuid = Uuid;
        return LoadPatientAsync();
    }

    /// <summary>
    /// Loads the patient header data. The insurance and advance-directive panels load their own data.
    /// A response for a patient the user has already left is dropped.
    /// </summary>
    private async Task LoadPatientAsync()
    {
        var requested = Uuid;
        _patient = null;
        _policyCount = null;
        _documentCount = null;
        _state = State.Loading;
        PatientPage.PatientName = null;

        if (await AuthFacade.TryGetCurrentUserAsync() is null)
        {
            _state = State.SignedOut;
            return;
        }

        try
        {
            var patient = await PatientManagement.GetPatientAsync(requested);
            if (requested != Uuid)
            {
                return; // navigated to another patient while this was in flight
            }

            _patient = patient;
            _state = State.Ready;
            PatientPage.PatientName = $"{patient.FirstName} {patient.LastName}";
            await RefreshCountsAsync();
        }
        catch (PatientManagementApiException ex) when (ex.StatusCode == 404)
        {
            _state = State.NotFound;
        }
        catch (PatientManagementApiException ex) when (ex.StatusCode is 401 or 403)
        {
            _state = State.SignedOut;
        }
        catch (Exception ex) when (ex is PatientManagementApiException or HttpRequestException)
        {
            _state = State.Error;
        }
    }
}
