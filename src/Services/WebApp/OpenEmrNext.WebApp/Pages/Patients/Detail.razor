@page "/patients/{Uuid:guid}"
@using OpenEmrNext.PatientManagement.Client
@using OpenEmrNext.WebApp.Shared
@using PatientManagementApiException = OpenEmrNext.PatientManagement.Client.ApiException
@inject IAuthFacadeClient AuthFacade
@inject IPatientManagementClient PatientManagement
@inject NavigationManager Navigation

<PageTitle>Patient</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-0">
    @switch (_state)
    {
        case State.Loading:
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" role="status" aria-label="Loading patient" />
            break;

        case State.SignedOut:
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                You need to be signed in to see this patient.
                <MudButton Variant="Variant.Text" Color="Color.Warning" Href="@LoginUrl">Log in with OpenEMR</MudButton>
            </MudAlert>
            break;

        case State.NotFound:
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">No patient with that id was found.</MudAlert>
            break;

        case State.Error:
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                Could not load this patient. The patient service may be unavailable.
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadPatientAsync">Try again</MudButton>
            </MudAlert>
            break;

        case State.Ready:
            var patient = _patient!;
            <MudText Typo="Typo.h5" GutterBottom="true" Class="mb-4">@patient.FirstName @patient.LastName</MudText>

            @* The overview opens first. Insurance and advance directives load only when their tab is opened.
               Each panel is keyed on the patient, so switching patients rebuilds it. *@
            <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
                <MudTabPanel Text="Overview">
                    <dl class="op-details">
                        <dt>Name</dt>
                        <dd>@patient.FirstName @patient.LastName</dd>
                        <dt>Patient ID</dt>
                        <dd>@(patient.PublicPatientId ?? patient.Pid.ToString())</dd>
                        <dt>Date of birth</dt>
                        <dd>@(patient.DateOfBirth?.ToString("yyyy-MM-dd") ?? "—")</dd>
                        <dt>Email</dt>
                        <dd>@(string.IsNullOrWhiteSpace(patient.Email) ? "—" : patient.Email)</dd>
                    </dl>
                </MudTabPanel>

                <MudTabPanel Text="Insurance">
                    <PatientInsurancePanel @key="patient.Pid" Pid="patient.Pid" />
                </MudTabPanel>

                <MudTabPanel Text="Advance directives">
                    <PatientAdvanceDirectivesPanel @key="patient.Pid" Pid="patient.Pid" />
                </MudTabPanel>
            </MudTabs>
            break;
    }
</MudContainer>

@code {
    private enum State { Loading, SignedOut, NotFound, Error, Ready }

    [Parameter] public Guid Uuid { get; set; }

    private State _state = State.Loading;
    private PatientSummaryResponse? _patient;
    private Guid? _loadedUuid;

    private string LoginUrl => $"/oidc/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}";

    /// <summary>
    /// Blazor reuses this page instance when only the route parameter changes (one patient to another),
    /// so loading only on first render would keep showing the previous patient.
    /// </summary>
    protected override Task OnParametersSetAsync()
    {
        if (_loadedUuid == Uuid)
        {
            return Task.CompletedTask;
        }

        _loadedUuid = Uuid;
        return LoadPatientAsync();
    }

    /// <summary>
    /// Loads the patient header data. The insurance and advance-directive panels load their own data.
    /// A response for a patient the user has already left is dropped.
    /// </summary>
    private async Task LoadPatientAsync()
    {
        var requested = Uuid;
        _patient = null;
        _state = State.Loading;

        if (await AuthFacade.TryGetCurrentUserAsync() is null)
        {
            _state = State.SignedOut;
            return;
        }

        try
        {
            var patient = await PatientManagement.GetPatientAsync(requested);
            if (requested != Uuid)
            {
                return; // navigated to another patient while this was in flight
            }

            _patient = patient;
            _state = State.Ready;
        }
        catch (PatientManagementApiException ex) when (ex.StatusCode == 404)
        {
            _state = State.NotFound;
        }
        catch (PatientManagementApiException ex) when (ex.StatusCode is 401 or 403)
        {
            _state = State.SignedOut;
        }
        catch (Exception ex) when (ex is PatientManagementApiException or HttpRequestException)
        {
            _state = State.Error;
        }
    }
}
