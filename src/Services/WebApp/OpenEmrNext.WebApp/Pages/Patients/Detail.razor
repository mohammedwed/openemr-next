@page "/patients/{Uuid:guid}"
@using OpenEmrNext.PatientManagement.Client
@using OpenEmrNext.WebApp.Shared
@using PatientManagementApiException = OpenEmrNext.PatientManagement.Client.ApiException
@inject IAuthFacadeClient AuthFacade
@inject IPatientManagementClient PatientManagement
@inject NavigationManager Navigation
@inject PatientPageContext PatientPage
@implements IDisposable

<PageTitle>@(_patient is null ? "Patient" : $"{_patient.FirstName} {_patient.LastName}")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-0">
    @switch (_state)
    {
        case State.Loading:
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" role="status" aria-label="Loading patient" />
            break;

        case State.SignedOut:
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                You need to be signed in to see this patient.
                <MudButton Variant="Variant.Text" Color="Color.Warning" Href="@LoginUrl">Log in with OpenEMR</MudButton>
            </MudAlert>
            break;

        case State.NotFound:
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">No patient with that id was found.</MudAlert>
            break;

        case State.Error:
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                Could not load this patient. The patient service may be unavailable.
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadPatientAsync">Try again</MudButton>
            </MudAlert>
            break;

        case State.Ready:
            var patient = _patient!;

            @* Basic information stays above the tabs, so it is never one click away. The name is the page's
               heading. Sections are loaded here, once, and each panel renders what it is given. *@
            <MudPaper Outlined="true" Class="pa-5 mb-6">
                <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">@patient.FirstName @patient.LastName</MudText>
                <dl class="op-details">
                    <dt>Patient ID</dt>
                    <dd>@(patient.PublicPatientId ?? patient.Pid.ToString())</dd>
                    <dt>Date of birth</dt>
                    <dd>@Formatting.DateOfBirthWithAge(patient.DateOfBirth, _today)</dd>
                    <dt>Email</dt>
                    <dd>@(string.IsNullOrWhiteSpace(patient.Email) ? "—" : patient.Email)</dd>
                </dl>
            </MudPaper>

            <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                <MudTabPanel Text="@WithCount("Insurance", _policies?.Count)">
                    <PatientInsurancePanel @key="patient.Pid" Pid="patient.Pid"
                        Policies="_policies" Error="_policiesError"
                        Changed="ReloadSectionsAsync" OnRetry="ReloadSectionsAsync" />
                </MudTabPanel>

                <MudTabPanel Text="@WithCount("Advance directives", _documents?.Count)">
                    <PatientAdvanceDirectivesPanel @key="patient.Pid" Pid="patient.Pid"
                        Status="_status" StatusError="_statusError"
                        Documents="_documents" DocumentsError="_documentsError"
                        Changed="ReloadSectionsAsync" OnRetry="ReloadSectionsAsync" />
                </MudTabPanel>
            </MudTabs>
            break;
    }
</MudContainer>

@code {
    private enum State { Loading, SignedOut, NotFound, Error, Ready }

    [Parameter] public Guid Uuid { get; set; }

    private State _state = State.Loading;
    private PatientSummaryResponse? _patient;
    private Guid? _loadedUuid;
    private DateOnly _today;

    // Null means "not loaded yet". Reloads keep the previous data on screen until the new data arrives.
    private IReadOnlyList<EffectiveInsuranceResponse>? _policies;
    private bool _policiesError;
    private AdvanceDirectiveStatusResponse? _status;
    private bool _statusError;
    private IReadOnlyList<AdvanceDirectiveDocumentResponse>? _documents;
    private bool _documentsError;

    private static string WithCount(string label, int? count) => count is null ? label : $"{label} ({count})";

    private string LoginUrl => $"/oidc/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}";

    /// <summary>
    /// Blazor reuses this page instance when only the route parameter changes (one patient to another),
    /// so loading only on first render would keep showing the previous patient.
    /// </summary>
    protected override Task OnParametersSetAsync()
    {
        if (_loadedUuid == Uuid)
        {
            return Task.CompletedTask;
        }

        _loadedUuid = Uuid;
        return LoadPatientAsync();
    }

    /// <summary>
    /// Loads the patient. Only the patient gates the page: a failed section shows its own message and retry.
    /// </summary>
    private async Task LoadPatientAsync()
    {
        PatientPage.PatientName = "Loading…";
        await LoadCoreAsync();
        if (_state != State.Ready)
        {
            PatientPage.PatientName = null; // the breadcrumb falls back to "Patient" when there is no patient
        }
    }

    private async Task LoadCoreAsync()
    {
        var requested = Uuid;
        _patient = null;
        _policies = null;
        _status = null;
        _documents = null;
        _policiesError = _statusError = _documentsError = false;
        _state = State.Loading;

        if (await AuthFacade.TryGetCurrentUserAsync() is null)
        {
            _state = State.SignedOut;
            return;
        }

        try
        {
            var patient = await PatientManagement.GetPatientAsync(requested);
            if (requested != Uuid)
            {
                return; // navigated to another patient while this was in flight
            }

            _patient = patient;
            _today = DateOnly.FromDateTime(DateTime.Today); // read once per load, not on every render
            _state = State.Ready;
            PatientPage.PatientName = $"{patient.FirstName} {patient.LastName}";
        }
        catch (PatientManagementApiException ex) when (ex.StatusCode == 404)
        {
            _state = State.NotFound;
            return;
        }
        catch (PatientManagementApiException ex) when (ex.StatusCode is 401 or 403)
        {
            _state = State.SignedOut;
            return;
        }
        catch (Exception ex) when (ex is PatientManagementApiException or HttpRequestException)
        {
            _state = State.Error;
            return;
        }

        // Sections load after the patient is shown. A failure here never changes the page state.
        await LoadSectionsAsync(_patient!.Pid);
    }

    /// <summary>Re-reads every section. Called after a change (so the data and tab counts stay current) and by retry.</summary>
    private Task ReloadSectionsAsync() => _patient is null ? Task.CompletedTask : LoadSectionsAsync(_patient.Pid);

    private Task LoadSectionsAsync(long pid) =>
        Task.WhenAll(LoadPoliciesAsync(pid), LoadStatusAsync(pid), LoadDocumentsAsync(pid));

    private async Task LoadPoliciesAsync(long pid)
    {
        try
        {
            var policies = await PatientManagement.GetEffectiveInsuranceAsync(pid, null);
            if (_patient?.Pid == pid)
            {
                _policies = [.. policies];
                _policiesError = false;
            }
        }
        catch (Exception ex) when (ex is PatientManagementApiException or HttpRequestException)
        {
            if (_patient?.Pid == pid)
            {
                _policiesError = true;
            }
        }

        StateHasChanged(); // each section appears as soon as it is ready, not when the slowest one finishes
    }

    private async Task LoadStatusAsync(long pid)
    {
        try
        {
            var status = await PatientManagement.GetAdvanceDirectiveStatusAsync(pid);
            if (_patient?.Pid == pid)
            {
                _status = status;
                _statusError = false;
            }
        }
        catch (Exception ex) when (ex is PatientManagementApiException or HttpRequestException)
        {
            if (_patient?.Pid == pid)
            {
                _statusError = true;
            }
        }

        StateHasChanged();
    }

    private async Task LoadDocumentsAsync(long pid)
    {
        try
        {
            var documents = await PatientManagement.GetAdvanceDirectiveDocumentsAsync(pid);
            if (_patient?.Pid == pid)
            {
                _documents = [.. documents];
                _documentsError = false;
            }
        }
        catch (Exception ex) when (ex is PatientManagementApiException or HttpRequestException)
        {
            if (_patient?.Pid == pid)
            {
                _documentsError = true;
            }
        }

        StateHasChanged();
    }

    public void Dispose() => PatientPage.PatientName = null;
}
