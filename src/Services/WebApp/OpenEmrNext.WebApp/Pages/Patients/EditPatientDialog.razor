@using OpenEmrNext.PatientManagement.Client
@using OpenEmrNext.WebApp.Shared
@using PatientManagementApiException = OpenEmrNext.PatientManagement.Client.ApiException
@inject IPatientManagementClient PatientManagement

@* Correcting a patient's name, date of birth, sex and emails (M5r, ADR 0081). It is a replacement of those six fields, so the dialog starts from every one of them as the patient is now and sends them all back: a
   field the form did not carry would be cleared. It is based on the version the page read; if someone else changed the patient since, the save is refused and the page reloads (the dialog closes as out of date). *@
<MudDialog>
    <DialogContent>
        @if (_error is { } error)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-4" role="alert">@error</MudAlert>
        }
        <MudForm @ref="_form" Model="_model">
            <MudGrid Spacing="4">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.FirstName" Label="First name" Required="true" RequiredError="First name is required." Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.LastName" Label="Last name" Required="true" RequiredError="Last name is required." Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    @* A sex the list does not offer (legacy holds whatever its screens let someone type) is offered as it is, so opening the dialog never silently changes it. *@
                    <MudSelect T="string" @bind-Value="_model.Sex" Label="Sex" Required="true" RequiredError="Choose a sex." Variant="Variant.Outlined">
                        @foreach (var option in SexOptions)
                        {
                            <MudSelectItem Value="@option">@option</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_model.DateOfBirth" Label="Date of birth" Required="true" RequiredError="Date of birth is required." Editable="true"
                        MaxDate="DateTime.Today" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Email" Label="Email (optional)" Variant="Variant.Outlined" InputType="InputType.Email" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.TrustedEmail" Label="Trusted email (optional)" Variant="Variant.Outlined" InputType="InputType.Email" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_saving">Save changes</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly string[] StandardSexOptions = ["Male", "Female", "Other", "Unknown"];

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>The patient as the page read them, with the version (<c>ETag</c>) the save is based on.</summary>
    [Parameter, EditorRequired] public PatientSummaryResponse Patient { get; set; } = null!;

    private MudForm _form = null!;
    private readonly FormModel _model = new();
    private IReadOnlyList<string> SexOptions = StandardSexOptions;
    private bool _saving;
    private string? _error;

    protected override void OnInitialized()
    {
        _model.FirstName = Patient.FirstName;
        _model.LastName = Patient.LastName;
        _model.Sex = Patient.Sex ?? "";
        _model.DateOfBirth = Patient.DateOfBirth is { } dob ? new DateTime(dob.Year, dob.Month, dob.Day) : null;
        _model.Email = Patient.Email;
        _model.TrustedEmail = Patient.TrustedEmail;

        if (!string.IsNullOrWhiteSpace(_model.Sex) && !StandardSexOptions.Contains(_model.Sex))
            SexOptions = [.. StandardSexOptions, _model.Sex];
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || _model.DateOfBirth is not { } dob)
        {
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            var request = new UpdatePatientRequest
            {
                FirstName = _model.FirstName.Trim(),
                LastName = _model.LastName.Trim(),
                Sex = _model.Sex,
                DateOfBirth = new DateTimeOffset(dob.Date),
                Email = string.IsNullOrWhiteSpace(_model.Email) ? null : _model.Email.Trim(),
                TrustedEmail = string.IsNullOrWhiteSpace(_model.TrustedEmail) ? null : _model.TrustedEmail.Trim()
            };
            var saved = await PatientManagement.UpdatePatientAsync(Patient.Uuid, Patient.ETag, request);
            MudDialog.Close(DialogResult.Ok(saved));
        }
        catch (PatientManagementApiException ex) when (ex.StatusCode == 412)
        {
            // Someone else changed this patient since the page read them: nothing was saved, and the page reloads what is stored now.
            MudDialog.Close(DialogResult.Ok(IssueDialogResult.OutOfDate()));
        }
        catch (PatientManagementApiException ex) when (ex.StatusCode == 404)
        {
            _error = "This patient no longer exists, so nothing was saved.";
        }
        catch (PatientManagementApiException ex)
        {
            _error = PatientManagementErrorFormatter.Describe(ex, "Could not save these changes. Please check the details and try again.");
        }
        catch (HttpRequestException)
        {
            _error = "Could not reach the patient service. Nothing was saved. Check your connection, then try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class FormModel
    {
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Sex { get; set; } = "";
        public DateTime? DateOfBirth { get; set; }
        public string? Email { get; set; }
        public string? TrustedEmail { get; set; }
    }
}
