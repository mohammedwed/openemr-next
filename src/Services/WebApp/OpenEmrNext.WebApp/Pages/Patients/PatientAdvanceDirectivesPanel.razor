@using OpenEmrNext.PatientManagement.Client
@using OpenEmrNext.WebApp.Shared
@using PatientManagementApiException = OpenEmrNext.PatientManagement.Client.ApiException
@inject IPatientManagementClient PatientManagement
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* Read-only by default. Recording a status or uploading a document opens its own dialog. *@
@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" role="status" aria-label="Loading advance directives" />
}
else
{
    @if (_advanceDirectiveError)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-4">
            Could not load advance directives.
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadAsync">Try again</MudButton>
        </MudAlert>
    }

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <div>
            <MudText Typo="Typo.subtitle2">Advance directive status</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @CodeLabels.Of(_status?.Status ?? "unknown") · reviewed @(_status?.ReviewedAtUtc?.ToString("yyyy-MM-dd") ?? "—")
            </MudText>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenSetStatusAsync">Set status</MudButton>
    </MudStack>

    <MudDivider Class="my-5" />

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.subtitle2">Documents</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenUploadAsync">Upload document</MudButton>
    </MudStack>

    <MudTable Items="_documents" Hover="true" Elevation="0" Dense="true">
        <HeaderContent>
            <MudTh>Type</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Size</MudTh>
            <MudTh>Effective date</MudTh>
            <MudTh><span class="op-visually-hidden">Actions</span></MudTh>
        </HeaderContent>
        <RowTemplate Context="document">
            <MudTd DataLabel="Type">@CodeLabels.Of(document.Type)</MudTd>
            <MudTd DataLabel="Name">@document.Name</MudTd>
            <MudTd DataLabel="Size">@Formatting.FileSize(document.Size)</MudTd>
            <MudTd DataLabel="Effective date">@(document.EffectiveDate?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
            <MudTd>
                @* Named per document: a row of identical "Download" links is not distinguishable to a screen reader. *@
                <MudLink Href="@DocumentContentUrl(document)" Target="_blank"
                    aria-label="@($"Download {document.Name} (opens in a new tab)")">Download</MudLink>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>No documents uploaded yet.</NoRecordsContent>
    </MudTable>
}

@code {
    [Parameter, EditorRequired] public long Pid { get; set; }

    private AdvanceDirectiveStatusResponse? _status;
    private List<AdvanceDirectiveDocumentResponse> _documents = [];
    private bool _loading = true;
    private bool _advanceDirectiveError;

    private string DocumentContentUrl(AdvanceDirectiveDocumentResponse document) =>
        $"/api/v1/patients/{Pid}/advance-directives/documents/{document.Uuid}/content";

    protected override Task OnInitializedAsync() => LoadAsync();

    // Only the first load shows the spinner. Reloads after a change keep the view on screen.
    private async Task LoadAsync()
    {
        try
        {
            _status = await PatientManagement.GetAdvanceDirectiveStatusAsync(Pid);
            var documents = await PatientManagement.GetAdvanceDirectiveDocumentsAsync(Pid);
            _documents = [.. documents];
            _advanceDirectiveError = false;
        }
        catch (PatientManagementApiException)
        {
            _advanceDirectiveError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenSetStatusAsync()
    {
        var parameters = new DialogParameters<SetAdvanceDirectiveStatusDialog>
        {
            { x => x.Pid, Pid },
            { x => x.CurrentStatus, _status?.Status ?? "unknown" },
        };
        var dialog = await DialogService.ShowAsync<SetAdvanceDirectiveStatusDialog>("Set advance directive status", parameters, DialogOptionsFor());
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Advance directive status saved.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenUploadAsync()
    {
        var parameters = new DialogParameters<UploadDocumentDialog> { { x => x.Pid, Pid } };
        var dialog = await DialogService.ShowAsync<UploadDocumentDialog>("Upload advance directive document", parameters, DialogOptionsFor());
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Document uploaded.", Severity.Success);
            await LoadAsync();
        }
    }

    private static DialogOptions DialogOptionsFor() =>
        new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
}
