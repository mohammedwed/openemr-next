@using OpenEmrNext.ClinicalCare.Client
@using OpenEmrNext.WebApp.Shared
@using ClinicalCareApiException = OpenEmrNext.ClinicalCare.Client.ApiException
@inject IClinicalCareClient ClinicalCare
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* Loads its own data, like the Encounters panel: ClinicalCare pages on the server (the API never returns "all allergies", API-6), so the panel owns the page it is
   showing and reports the total up through TotalChanged for the tab label. A failed first load shows an error with "Try again"; a failed page change keeps the last
   page on screen with a warning. An allergy is ended by an end date, not by a flag (ADR 0070), so End and Reopen are updates, made with the version the row was
   listed with: if someone changed it in the meantime the save is refused and the list reloads. *@
<PatientSectionCard Title="Allergies"
    HasData="_items is not null" Error="_error" OnRetry="LoadAsync"
    ErrorMessage="Could not load allergies. The clinical care service may be unavailable."
    StaleMessage="Could not refresh allergies. The list below may be out of date."
    LoadingLabel="Loading allergies">
    <Summary>
        <MudText Typo="Typo.body2" Class="mud-text-secondary" role="status">
            @(_total == 1 ? "1 allergy" : $"{_total} allergies")@(_total > PageSize ? $" · page {_page} of {PageCount}" : "")
        </MudText>
    </Summary>
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenRecordAsync">Record allergy</MudButton>
    </Actions>
    <ChildContent>
        <MudTable Items="_items ?? []" Hover="true" Elevation="0"
            TableAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Allergies" })">
            <HeaderContent>
                <MudTh>Substance</MudTh>
                <MudTh>Reaction</MudTh>
                <MudTh>Severity</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Verification</MudTh>
                <MudTh><span class="op-visually-hidden">Actions</span></MudTh>
            </HeaderContent>
            <RowTemplate Context="allergy">
                <MudTd DataLabel="Substance">
                    <span class="op-clamp" title="@allergy.Title">@(string.IsNullOrWhiteSpace(allergy.Title) ? "(untitled)" : allergy.Title)</span>
                    @if (!string.IsNullOrWhiteSpace(allergy.Diagnosis))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@allergy.Diagnosis</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Reaction">@(string.IsNullOrWhiteSpace(allergy.Reaction) ? "—" : CodeLabels.Of(allergy.Reaction))</MudTd>
                <MudTd DataLabel="Severity">@(string.IsNullOrWhiteSpace(allergy.Severity) ? "—" : CodeLabels.Of(allergy.Severity))</MudTd>
                <MudTd DataLabel="Status">
                    @if (allergy.EndDate is null)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error">Active</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">Ended @Formatting.DateText(allergy.EndDate)</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Verification">@(string.IsNullOrWhiteSpace(allergy.Verification) ? "—" : CodeLabels.Of(allergy.Verification))</MudTd>
                <MudTd>
                    @* Named per allergy: a column of identical "Edit" buttons is not distinguishable to a screen reader. *@
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Disabled="@Busy(allergy)" OnClick="@(() => OpenEditAsync(allergy))"
                        aria-label="@($"Edit allergy {allergy.Title}")">Edit</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" Disabled="@Busy(allergy)" OnClick="@(() => DeleteAsync(allergy))"
                        aria-label="@($"Delete allergy {allergy.Title}")">Delete</MudButton>
                    @if (allergy.EndDate is null)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Disabled="@Busy(allergy)" OnClick="@(() => SetEndedAsync(allergy, ended: true))"
                            aria-label="@($"End allergy {allergy.Title}")">End</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small" Disabled="@Busy(allergy)" OnClick="@(() => SetEndedAsync(allergy, ended: false))"
                            aria-label="@($"Reopen allergy {allergy.Title}")">Reopen</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudStack Spacing="2" AlignItems="AlignItems.Start" Class="py-2">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No allergies recorded for this patient yet.</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="OpenRecordAsync">Record the first allergy</MudButton>
                </MudStack>
            </NoRecordsContent>
        </MudTable>

        @if (PageCount > 1)
        {
            <MudStack AlignItems="AlignItems.Center" Class="mt-4">
                <MudPagination Count="PageCount" Selected="_page" SelectedChanged="OnPageChangedAsync"
                    ShowFirstButton="true" ShowLastButton="true" Disabled="_loading" aria-label="Allergy pages" />
            </MudStack>
        }
    </ChildContent>
</PatientSectionCard>

@code {
    private const int PageSize = 10;

    [Parameter, EditorRequired] public Guid PatientUuid { get; set; }

    /// <summary>Raised with the patient's total allergy count after each successful load, for the tab label.</summary>
    [Parameter] public EventCallback<int> TotalChanged { get; set; }

    // Null means "not loaded yet". A failed page change keeps the previous page here on purpose.
    private List<AllergyResponse>? _items;
    private int _total;
    private int _page = 1;
    private bool _error;
    private bool _loading;

    // The row whose quick action is in flight, so it cannot be clicked twice and cannot race itself.
    private Guid? _busy;

    // Each load takes a number; only the latest one may apply its result, so a slow response for an earlier page can never overwrite a newer one.
    private int _loadCounter;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_total / (double)PageSize));

    private bool Busy(AllergyResponse allergy) => _busy == allergy.Uuid;

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task OnPageChangedAsync(int page) => LoadAsync(page);

    private Task LoadAsync() => LoadAsync(_page);

    private async Task LoadAsync(int page)
    {
        var ticket = ++_loadCounter;
        _loading = true;
        try
        {
            var result = await ClinicalCare.ListAllergiesAsync(PatientUuid, PageSize, (page - 1) * PageSize);
            if (ticket != _loadCounter)
            {
                return; // a newer load has started since this one
            }

            _items = [.. result.Items];
            _total = result.Total;
            _page = page;
            _error = false;
            await TotalChanged.InvokeAsync(_total);
        }
        catch (Exception ex) when (ex is ClinicalCareApiException or HttpRequestException)
        {
            if (ticket == _loadCounter)
            {
                _error = true;
            }
        }
        finally
        {
            if (ticket == _loadCounter)
            {
                _loading = false;
            }
        }
    }

    private async Task OpenRecordAsync()
    {
        var parameters = new DialogParameters<AllergyDialog> { { x => x.PatientUuid, PatientUuid } };
        await ShowDialogAsync("Record allergy", parameters);
    }

    /// <summary>
    /// Deleting removes the allergy and its links to encounters, as OpenEMR does (ADR 0080), so the confirmation says it cannot be undone. Needs OpenEMR's administrator right: the service refuses anyone else and
    /// <see cref="RecordDeletion"/> explains it. Based on the version the row was listed with.
    /// </summary>
    private async Task DeleteAsync(AllergyResponse allergy)
    {
        _busy = allergy.Uuid;
        try
        {
            var reload = await RecordDeletion.ConfirmAndDeleteAsync(
                DialogService, Snackbar, "Delete this allergy?",
                $"\"{allergy.Title}\" is removed from the patient's record, here and in OpenEMR, together with its links to encounters. It cannot be restored. Ending an allergy instead keeps it on the record.",
                () => ClinicalCare.DeleteAllergyAsync(allergy.Uuid, allergy.ETag));
            if (reload)
            {
                await LoadAsync(_page > 1 && _items?.Count == 1 ? _page - 1 : _page);
            }
        }
        finally
        {
            _busy = null;
        }
    }

    private async Task OpenEditAsync(AllergyResponse allergy)
    {
        var parameters = new DialogParameters<AllergyDialog> { { x => x.PatientUuid, PatientUuid }, { x => x.Existing, allergy } };
        await ShowDialogAsync("Edit allergy", parameters);
    }

    private async Task ShowDialogAsync(string title, DialogParameters<AllergyDialog> parameters)
    {
        var dialog = await DialogService.ShowAsync<AllergyDialog>(title, parameters, DialogDefaults.Standard);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: IssueDialogResult saved })
        {
            return;
        }

        if (saved.Stale)
        {
            Snackbar.Add("That allergy was changed by someone else, so nothing was saved. The list now shows what is stored.", Severity.Warning);
        }
        else
        {
            Snackbar.Add(saved.IsNew ? $"Allergy recorded: {saved.Title}." : $"Allergy saved: {saved.Title}.", Severity.Success);
        }

        await LoadAsync();
    }

    /// <summary>
    /// Ending an allergy is an update that sets an end date; reopening clears it. It re-sends every other field exactly as listed, and is based on the version the row was
    /// listed with, so a change made elsewhere in the meantime is refused and not overwritten.
    /// </summary>
    private async Task SetEndedAsync(AllergyResponse allergy, bool ended)
    {
        _busy = allergy.Uuid;
        try
        {
            var (beginDate, beginTime) = IssueWire.FromWire(allergy.BeginDate);
            await ClinicalCare.UpdateAllergyAsync(allergy.Uuid, allergy.ETag, new UpdateAllergyRequest
            {
                Title = allergy.Title,
                BeginDate = IssueWire.ToWire(beginDate, beginTime),
                EndDate = ended ? IssueWire.Today() : null,
                Diagnosis = allergy.Diagnosis,
                Reaction = allergy.Reaction,
                Severity = allergy.Severity,
                Verification = allergy.Verification,
                Comments = allergy.Comments
            });
            Snackbar.Add(ended ? $"Allergy ended: {allergy.Title}." : $"Allergy reopened: {allergy.Title}.", Severity.Success);
        }
        catch (ClinicalCareApiException ex)
        {
            Snackbar.Add(
                ClinicalCareErrorFormatter.IsStale(ex)
                    ? "That allergy was changed by someone else, so nothing was saved. The list now shows what is stored."
                    : ClinicalCareErrorFormatter.Describe(ex, "Could not update this allergy. Please try again."),
                ClinicalCareErrorFormatter.IsStale(ex) ? Severity.Warning : Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not reach the clinical care service. Nothing was saved. Check your connection, then try again.", Severity.Error);
        }
        finally
        {
            _busy = null;
        }

        // Always reload: on success to show the new state and version, on a stale refusal to show what is stored now.
        await LoadAsync();
    }
}
