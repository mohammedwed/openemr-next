@using OpenEmrNext.ClinicalCare.Client
@using OpenEmrNext.WebApp.Shared
@using ClinicalCareApiException = OpenEmrNext.ClinicalCare.Client.ApiException
@inject IClinicalCareClient ClinicalCare
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* Loads its own data, like the Problems panel: ClinicalCare pages on the server (API-6), so the panel owns the page it is showing and reports the total up for the tab label. A failed first load shows an error
   with "Try again"; a failed page change keeps the last page on screen with a warning. An edit is based on the version the row was listed with (a content version, ADR 0072), so a record changed elsewhere
   in the meantime is refused and the list reloads. An entry is voided with "entered in error", not deleted. The vaccine names come from the configured list, loaded once; if that fails the rows
   fall back to the CVX code or the vaccine's number. *@
<PatientSectionCard Title="Immunizations"
    HasData="_items is not null" Error="_error" StillSettingUp="_settingUp" OnRetry="LoadAsync"
    ErrorMessage="Could not load immunizations. The clinical care service may be unavailable."
    StaleMessage="Could not refresh immunizations. The list below may be out of date."
    LoadingLabel="Loading immunizations">
    <Summary>
        <MudText Typo="Typo.body2" Class="mud-text-secondary" role="status">
            @(_total == 1 ? "1 immunization" : $"{_total} immunizations")@(_total > PageSize ? $" · page {_page} of {PageCount}" : "")
        </MudText>
    </Summary>
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenRecordAsync">Record immunization</MudButton>
    </Actions>
    <ChildContent>
        <MudTable Items="_items ?? []" Hover="true" Elevation="0"
            TableAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Immunizations" })">
            <HeaderContent>
                <MudTh>Given</MudTh>
                <MudTh>Vaccine</MudTh>
                <MudTh>Product</MudTh>
                <MudTh>Status</MudTh>
                <MudTh><span class="op-visually-hidden">Actions</span></MudTh>
            </HeaderContent>
            <RowTemplate Context="item">
                <MudTd DataLabel="Given">
                    <div>@Formatting.DateTimeText(item.AdministeredDate)</div>
                    @if (!string.IsNullOrWhiteSpace(item.AdministeredBy))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">by @item.AdministeredBy</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Vaccine">
                    <span class="op-clamp">@VaccineName(item)</span>
                    @if (!string.IsNullOrWhiteSpace(item.CvxCode) && item.ImmunizationId is not null)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">CVX @item.CvxCode</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Product">
                    @if (string.IsNullOrWhiteSpace(item.LotNumber) && string.IsNullOrWhiteSpace(item.Manufacturer))
                    {
                        <span>—</span>
                    }
                    else
                    {
                        <div>@(string.IsNullOrWhiteSpace(item.Manufacturer) ? "" : item.Manufacturer)</div>
                        @if (!string.IsNullOrWhiteSpace(item.LotNumber))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Lot @item.LotNumber</MudText>
                        }
                    }
                </MudTd>
                <MudTd DataLabel="Status">
                    @if (item.EnteredInError)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">Entered in error</MudChip>
                    }
                    else if (!string.IsNullOrWhiteSpace(item.CompletionStatus))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@item.CompletionStatus</MudChip>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </MudTd>
                <MudTd>
                    @* Named per record: a column of identical "Edit" buttons is not distinguishable to a screen reader. *@
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditAsync(item))"
                        aria-label="@($"Edit the immunization given {Formatting.DateText(item.AdministeredDate)}")">Edit</MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudStack Spacing="2" AlignItems="AlignItems.Start" Class="py-2">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No immunizations recorded for this patient yet.</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="OpenRecordAsync">Record the first immunization</MudButton>
                </MudStack>
            </NoRecordsContent>
        </MudTable>

        @if (PageCount > 1)
        {
            <MudStack AlignItems="AlignItems.Center" Class="mt-4">
                <MudPagination Count="PageCount" Selected="_page" SelectedChanged="OnPageChangedAsync"
                    ShowFirstButton="true" ShowLastButton="true" Disabled="_loading" aria-label="Immunization pages" />
            </MudStack>
        }
    </ChildContent>
</PatientSectionCard>

@code {
    private const int PageSize = 10;

    [Parameter, EditorRequired] public Guid PatientUuid { get; set; }

    /// <summary>Raised with the patient's total immunization count after each successful load, for the tab label.</summary>
    [Parameter] public EventCallback<int> TotalChanged { get; set; }

    private List<ImmunizationResponse>? _items;
    private int _total;
    private int _page = 1;
    private bool _error;

    /// <summary>The last failure was Clinical Care not knowing this patient yet (404): registration is only a few seconds old, so the card says so and retries.</summary>
    private bool _settingUp;
    private bool _loading;
    private int _loadCounter;

    // Vaccine id to name, from the configured list. Best effort: it only improves the labels.
    private Dictionary<int, string> _vaccineNames = [];

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_total / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var options = await ClinicalCare.GetImmunizationOptionsAsync();
            _vaccineNames = options.Vaccines.Where(o => int.TryParse(o.Id, out _)).ToDictionary(o => int.Parse(o.Id), o => o.Title);
        }
        catch (Exception ex) when (ex is ClinicalCareApiException or HttpRequestException)
        {
            // The rows fall back to the CVX code or the number.
        }

        await LoadAsync();
    }

    private string VaccineName(ImmunizationResponse item) =>
        item.ImmunizationId is { } id
            ? _vaccineNames.TryGetValue(id, out var name) ? name : $"Vaccine {id}"
            : string.IsNullOrWhiteSpace(item.CvxCode) ? "—" : $"CVX {item.CvxCode}";

    private Task OnPageChangedAsync(int page) => LoadAsync(page);

    private Task LoadAsync() => LoadAsync(_page);

    private async Task LoadAsync(int page)
    {
        var ticket = ++_loadCounter;
        _loading = true;
        try
        {
            var result = await ClinicalCare.ListImmunizationsAsync(PatientUuid, PageSize, (page - 1) * PageSize);
            if (ticket != _loadCounter)
            {
                return; // a newer load has started since this one
            }

            _items = [.. result.Items];
            _total = result.Total;
            _page = page;
            _error = false;
            _settingUp = false;
            await TotalChanged.InvokeAsync(_total);
        }
        catch (Exception ex) when (ex is ClinicalCareApiException or HttpRequestException)
        {
            if (ticket == _loadCounter)
            {
                _error = true;
                _settingUp = ex is ClinicalCareApiException { StatusCode: 404 };
            }
        }
        finally
        {
            if (ticket == _loadCounter)
            {
                _loading = false;
            }
        }
    }

    private Task OpenRecordAsync() => ShowAsync("Record immunization", null);

    private Task OpenEditAsync(ImmunizationResponse item) => ShowAsync("Edit immunization", item);

    private async Task ShowAsync(string title, ImmunizationResponse? existing)
    {
        var parameters = new DialogParameters<ImmunizationDialog> { { x => x.PatientUuid, PatientUuid }, { x => x.Existing, existing } };
        var dialog = await DialogService.ShowAsync<ImmunizationDialog>(title, parameters, DialogDefaults.Wide);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: IssueDialogResult saved })
        {
            return;
        }

        Snackbar.Add(
            saved.Stale
                ? "That immunization was changed by someone else (or no longer exists), so nothing was saved. The list now shows what is stored."
                : saved.IsNew ? "Immunization recorded." : "Immunization saved.",
            saved.Stale ? Severity.Warning : Severity.Success);

        await LoadAsync(saved.IsNew ? 1 : _page);
    }
}
