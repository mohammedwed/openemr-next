@page "/patients/register"
@using System.ComponentModel.DataAnnotations
@using OpenEmrNext.PatientManagement.Client
@using AuthFacadeApiException = OpenEmrNext.AuthFacade.Client.ApiException
@using PatientManagementApiException = OpenEmrNext.PatientManagement.Client.ApiException
@inject IAuthFacadeClient AuthFacade
@inject IPatientManagementClient PatientManagement
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Register patient</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
    <MudText Typo="Typo.h5" Class="mb-6">Register patient</MudText>

    @switch (_state)
    {
        case State.Loading:
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            break;

        case State.SignedOut:
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                You need to be signed in to register a patient.
                <MudButton Variant="Variant.Text" Color="Color.Warning" Href="@LoginUrl">Log in with OpenEMR</MudButton>
            </MudAlert>
            break;

        case State.Ready:
            <MudPaper Elevation="1" Class="pa-6">
                <MudForm @ref="_form" Model="_model">
                    @if (_errorMessage is { } message)
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-4">@message</MudAlert>
                    }
                    <MudStack Spacing="4">
                        <MudTextField @bind-Value="_model.FirstName" Label="First name" Required="true" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_model.LastName" Label="Last name" Required="true" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_model.Sex" Label="Sex" Required="true" Variant="Variant.Outlined"
                            HelperText="Free text, matching OpenEMR's own sex column" />
                        <MudDatePicker @bind-Date="_model.DateOfBirth" Label="Date of birth" Required="true" />
                        <MudTextField @bind-Value="_model.Email" Label="Email (optional)" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_model.TrustedEmail" Label="Trusted email (optional)" Variant="Variant.Outlined" />
                        <div>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_submitting">
                                Register
                            </MudButton>
                        </div>
                    </MudStack>
                </MudForm>
            </MudPaper>
            break;
    }
</MudContainer>

@code {
    private enum State { Loading, SignedOut, Ready }

    /// <summary>
    /// The id of the user performing the registration. No real numeric id exists to supply here --
    /// AuthFacade's session only carries OpenEMR's UUID <c>sub</c> claim, and there's no lookup from
    /// that to a numeric <c>users.id</c> (ADR 0055's tracked gap). A fixed placeholder, same framing
    /// the backend itself already uses for this exact gap, not a new decision made here.
    /// </summary>
    private const long PlaceholderRegisteredById = 1;

    private State _state = State.Loading;
    private MudForm? _form;
    private readonly FormModel _model = new();
    private bool _submitting;
    private string? _errorMessage;

    private string LoginUrl => $"/oidc/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await AuthFacade.GetCurrentUserAsync();
            _state = State.Ready;
        }
        catch (AuthFacadeApiException)
        {
            _state = State.SignedOut;
        }
    }

    private async Task SubmitAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid || _model.DateOfBirth is null)
        {
            return;
        }

        _submitting = true;
        _errorMessage = null;
        try
        {
            var request = new RegisterPatientRequest
            {
                FirstName = _model.FirstName,
                LastName = _model.LastName,
                Sex = _model.Sex,
                DateOfBirth = new DateTimeOffset(_model.DateOfBirth.Value),
                Email = string.IsNullOrWhiteSpace(_model.Email) ? null : _model.Email,
                TrustedEmail = string.IsNullOrWhiteSpace(_model.TrustedEmail) ? null : _model.TrustedEmail,
                RegisteredBy = PlaceholderRegisteredById
            };
            await PatientManagement.RegisterPatientAsync(request);
            Snackbar.Add($"Registered {_model.FirstName} {_model.LastName}.", Severity.Success);
            Navigation.NavigateTo("/patients");
        }
        catch (PatientManagementApiException ex)
        {
            _errorMessage = PatientManagementErrorFormatter.Describe(
                ex, "Something went wrong registering this patient. Please check the details and try again.");
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class FormModel
    {
        [Required, MinLength(1), MaxLength(255)]
        public string FirstName { get; set; } = "";

        [Required, MinLength(2), MaxLength(255)]
        public string LastName { get; set; } = "";

        [Required, MinLength(4), MaxLength(30)]
        public string Sex { get; set; } = "";

        public DateTime? DateOfBirth { get; set; }

        [EmailAddress]
        public string? Email { get; set; }

        [EmailAddress]
        public string? TrustedEmail { get; set; }
    }
}
