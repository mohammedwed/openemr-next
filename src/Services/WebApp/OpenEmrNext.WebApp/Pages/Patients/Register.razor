@page "/patients/register"
@using System.ComponentModel.DataAnnotations
@using OpenEmrNext.PatientManagement.Client
@using OpenEmrNext.WebApp.Shared
@using PatientManagementApiException = OpenEmrNext.PatientManagement.Client.ApiException
@inject IAuthFacadeClient AuthFacade
@inject IPatientManagementClient PatientManagement
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>Register patient</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-0">
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-6">Register patient</MudText>

    @switch (_state)
    {
        case State.Loading:
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" role="status" aria-label="Checking sign-in" />
            break;

        case State.SignedOut:
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                You need to be signed in to register a patient.
                <MudButton Variant="Variant.Text" Color="Color.Warning" Href="@LoginUrl">Log in with OpenEMR</MudButton>
            </MudAlert>
            break;

        case State.Error:
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                Could not check your sign-in. The service may be unavailable.
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="CheckSignInAsync">Try again</MudButton>
            </MudAlert>
            break;

        case State.Ready:
            <MudPaper Elevation="1" Class="pa-6">
                <MudForm @ref="_form" Model="_model">
                    @if (_errorMessage is { } message)
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-4">@message</MudAlert>
                    }
                    @* Paired fields share a row on wider screens and stack on phones. *@
                    <MudGrid Spacing="4">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_model.FirstName" Label="First name" Required="true" RequiredError="First name is required."
                                Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_model.LastName" Label="Last name" Required="true" RequiredError="Last name is required."
                                Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" @bind-Value="_model.Sex" Label="Sex" Required="true" RequiredError="Choose a sex."
                                Variant="Variant.Outlined">
                                @foreach (var option in SexOptions)
                                {
                                    <MudSelectItem Value="@option">@option</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="_model.DateOfBirth" Label="Date of birth" Required="true"
                                RequiredError="Date of birth is required." Editable="true" MaxDate="DateTime.Today" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.Email" Label="Email (optional)" Variant="Variant.Outlined" InputType="InputType.Email" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.TrustedEmail" Label="Trusted email (optional)" Variant="Variant.Outlined" InputType="InputType.Email" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_submitting">
                                Register
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudForm>
            </MudPaper>
            break;
    }
</MudContainer>

@code {
    private enum State { Loading, SignedOut, Error, Ready }

    /// <summary>
    /// The values offered for sex. Matches the values already used for administrative sex in OpenEMR's own
    /// list and in the patient tests ("Female", "Male"), so a registered patient reads the same everywhere.
    /// </summary>
    private static readonly string[] SexOptions = ["Male", "Female", "Other", "Unknown"];

    private State _state = State.Loading;
    private MudForm? _form;
    private readonly FormModel _model = new();
    private bool _submitting;
    private string? _errorMessage;

    private string LoginUrl => $"/oidc/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}";

    private bool _saved;
    private IDisposable? _leaveGuard;

    protected override Task OnInitializedAsync()
    {
        _leaveGuard = Navigation.RegisterLocationChangingHandler(OnLocationChangingAsync);
        return CheckSignInAsync();
    }

    private bool IsDirty =>
        !string.IsNullOrEmpty(_model.FirstName) || !string.IsNullOrEmpty(_model.LastName) ||
        !string.IsNullOrEmpty(_model.Sex) || _model.DateOfBirth is not null ||
        !string.IsNullOrEmpty(_model.Email) || !string.IsNullOrEmpty(_model.TrustedEmail);

    /// <summary>
    /// Asks before leaving with typed-in details that have not been saved. Lost input is worse than one extra
    /// click, so the prompt names what will be lost and defaults to keeping the form.
    /// </summary>
    private async ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        if (_saved || _submitting || !IsDirty)
        {
            return;
        }

        var discard = await DialogService.ShowMessageBoxAsync(
            "Discard this registration?",
            "The details you entered have not been saved. Leaving this page will lose them.",
            yesText: "Discard", cancelText: "Keep editing");
        if (discard != true)
        {
            context.PreventNavigation();
        }
    }

    public void Dispose() => _leaveGuard?.Dispose();

    /// <summary>
    /// An API rejection means signed out. A network failure is shown as an outage with "Try again", not as
    /// signed out, so a visitor is not sent to log in because the service was down.
    /// </summary>
    private async Task CheckSignInAsync()
    {
        _state = State.Loading;
        try
        {
            _state = await AuthFacade.TryGetCurrentUserAsync() is null ? State.SignedOut : State.Ready;
        }
        catch (HttpRequestException)
        {
            _state = State.Error;
        }
    }

    private async Task SubmitAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid || _model.DateOfBirth is null)
        {
            return;
        }

        _submitting = true;
        _errorMessage = null;
        try
        {
            var request = new RegisterPatientRequest
            {
                FirstName = _model.FirstName,
                LastName = _model.LastName,
                Sex = _model.Sex,
                DateOfBirth = new DateTimeOffset(_model.DateOfBirth.Value),
                Email = string.IsNullOrWhiteSpace(_model.Email) ? null : _model.Email,
                TrustedEmail = string.IsNullOrWhiteSpace(_model.TrustedEmail) ? null : _model.TrustedEmail
            };
            var registered = await PatientManagement.RegisterPatientAsync(request);
            Snackbar.Add($"Registered {_model.FirstName} {_model.LastName} (patient ID {registered.Pubpid}).", Severity.Success);
            _saved = true; // leaving now is expected, so the unsaved-changes prompt must not appear
            Navigation.NavigateTo($"/patients/{registered.Uuid}");
        }
        catch (PatientManagementApiException ex)
        {
            _errorMessage = PatientManagementErrorFormatter.Describe(
                ex, "Something went wrong registering this patient. Please check the details and try again.");
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Could not reach the patient service. Nothing was saved. Check your connection, then try again.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class FormModel
    {
        [Required(ErrorMessage = "First name is required.")]
        [MaxLength(255, ErrorMessage = "First name must be 255 characters or fewer.")]
        public string FirstName { get; set; } = "";

        [Required(ErrorMessage = "Last name is required.")]
        [MinLength(2, ErrorMessage = "Last name must be at least 2 characters.")]
        [MaxLength(255, ErrorMessage = "Last name must be 255 characters or fewer.")]
        public string LastName { get; set; } = "";

        [Required(ErrorMessage = "Choose a sex.")]
        public string Sex { get; set; } = "";

        [Required(ErrorMessage = "Date of birth is required.")]
        [NotInFuture]
        public DateTime? DateOfBirth { get; set; }

        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string? Email { get; set; }

        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string? TrustedEmail { get; set; }
    }

    /// <summary>A date of birth cannot be after today. Shown on the field, not as a form-wide error.</summary>
    private sealed class NotInFutureAttribute : ValidationAttribute
    {
        public NotInFutureAttribute() : base("Date of birth cannot be in the future.") { }

        public override bool IsValid(object? value) =>
            value is not DateTime date || date.Date <= DateTime.Today;
    }
}
