<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- FakeOpenEmrServer signs its own id_tokens (pulls in Microsoft.IdentityModel.Tokens transitively);
         the Api project no longer references this directly now that the token-verifier code is gone. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    <!-- Same Polly v7/v8 conflict the Api project's csproj explains (ADR 0041): its exclusions do not stop
         the conflict flowing transitively into this project through the ProjectReference below, so both
         need repeating here too, excluding compile assets only: these tests actually run the real
         pipeline, which needs Polly v7 loadable at runtime. -->
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.11" ExcludeAssets="compile" />
    <PackageReference Include="Polly" Version="7.2.4" ExcludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Services\AuthFacade\OpenEmrNext.AuthFacade.Api\OpenEmrNext.AuthFacade.Api.csproj" />
    <ProjectReference Include="..\..\..\..\src\Services\AuthFacade\OpenEmrNext.AuthFacade.Client\OpenEmrNext.AuthFacade.Client.csproj" />
  </ItemGroup>

</Project>
