<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.MariaDb" Version="4.2.0" />
    <!-- Pins past Testcontainers' transitive SSH.NET 2024.1.0, which NuGet flags for two known high
         severity vulnerabilities (GHSA-mggc-4xg6-vcxf, GHSA-q939-rpr3-3284). Not used directly, only
         Testcontainers' optional SSH-tunnel feature touches it, which these tests never exercise, but
         pinned anyway, matching AuthFacade's own precedent for a vulnerable transitive package. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Services\PatientManagement\OpenEmrNext.PatientManagement.Api\OpenEmrNext.PatientManagement.Api.csproj" />
    <ProjectReference Include="..\..\..\..\src\Services\PatientManagement\OpenEmrNext.PatientManagement.Domain\OpenEmrNext.PatientManagement.Domain.csproj" />
    <ProjectReference Include="..\..\..\..\src\Services\PatientManagement\OpenEmrNext.PatientManagement.Application\OpenEmrNext.PatientManagement.Application.csproj" />
    <ProjectReference Include="..\..\..\..\src\Services\PatientManagement\OpenEmrNext.PatientManagement.Infrastructure\OpenEmrNext.PatientManagement.Infrastructure.csproj" />
  </ItemGroup>

</Project>
